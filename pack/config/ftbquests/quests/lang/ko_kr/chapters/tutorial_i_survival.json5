{
	"quest.16805CA750A56CF0.title": "갈증의 시작",
	"quest.16805CA750A56CF0.quest_desc": [
		"갈증 수치가 시간에 따라 줄어듭니다. I장은 0장을 끝내지 않아도 시작할 수 있습니다.",
		"직접 체크하세요."
	],
	"quest.1F2C60E5F492F7F7.title": "물에도 등급이 있다",
	"quest.1F2C60E5F492F7F7.quest_desc": [
		"JEI에서 증류수·민물·오염된 물·바닷물 병과 양동이를 확인해 보세요.",
		"증류수는 갈증을 40 회복하고, 민물과 오염된 물은 20 회복합니다. 바닷물은 갈증을 14 낮춥니다.",
		"직접 체크하세요."
	],
	"quest.7F6A12BCDD461FBC.title": "오염된 물 한 양동이",
	"quest.7F6A12BCDD461FBC.quest_desc": [
		"월드에 고여 있는 물은 대부분 오염된 물입니다. 마시기 전에 등급을 확인하세요."
	],
	"quest.6CC88228A9A8BEE4.title": "바닷물",
	"quest.6CC88228A9A8BEE4.quest_desc": [
		"바닷물은 마시는 물이 아니라 소금의 재료입니다."
	],
	"quest.180334DE39A061A4.title": "민물 한 병",
	"quest.180334DE39A061A4.quest_desc": [
		"민물은 마실 수 있으며, 갈증을 20 회복합니다."
	],
	"quest.1004C3F401989E5B.title": "민물 마시기",
	"quest.1004C3F401989E5B.quest_desc": [
		"민물 병 한 개를 제출하면 완료됩니다. 제출한 병은 소비됩니다.",
		"제출과 별개로 민물 병을 하나 더 마셔 갈증이 20 회복되는지 확인해 보세요. 강가에서 맨손으로 마시는 물은 병보다 훨씬 적게 회복합니다."
	],
	"quest.4AC76AF1FF3A1545.title": "불씨",
	"quest.4AC76AF1FF3A1545.quest_desc": [
		"증류기를 돌릴 화로를 준비하세요."
	],
	"quest.5A4554C0626A3F6C.title": "증류기",
	"quest.5A4554C0626A3F6C.quest_desc": [
		"증류기로 물을 끓여 증류수로 만드세요."
	],
	"quest.7E39F4B86338AFE6.title": "첫 증류수",
	"quest.7E39F4B86338AFE6.quest_desc": [
		"증류수 병 세 개를 제출하세요. 증류수는 갈증을 40 회복합니다. 다른 등급의 물은 인정되지 않습니다."
	],
	"quest.30809E75BF07E369.title": "정수 필터",
	"quest.30809E75BF07E369.quest_desc": [
		"정수 필터로 물을 거르면 민물 병을 얻습니다."
	],
	"quest.5931B14D8516EFFE.title": "필터 카트리지",
	"quest.5931B14D8516EFFE.quest_desc": [
		"필터 카트리지는 사용할수록 닳습니다. 정수 기능을 유지하려면 새 카트리지로 교체하세요."
	],
	"quest.715BB8259B11F742.title": "필터로 정수하기",
	"quest.715BB8259B11F742.quest_desc": [
		"정수 필터로 만든 민물 병 세 개를 제출하세요. 증류수나 오염된 물은 인정되지 않습니다."
	],
	"quest.6E84A458941768A9.title": "물 비축",
	"quest.6E84A458941768A9.quest_desc": [
		"탐험을 떠나기 전에 마실 물을 챙기세요. 제출하지 않고 보유 여부만 확인하는 과제입니다."
	],
	"quest.2140E3AD1708060E.title": "바닷물에서 소금 얻기",
	"quest.2140E3AD1708060E.quest_desc": [
		"소금 네 개를 제출하세요. 바닷물 양동이를 증류기에 넣으면 소금이 부산물로 나옵니다."
	],
	"quest.4FAEE362E469342B.title": "소금 보관하기",
	"quest.4FAEE362E469342B.quest_desc": [
		"소금 블록은 소금을 보관하거나 건축 재료로 쓸 수 있습니다."
	],
	"quest.1E4FAFA5D6C6A4F5.title": "온도계",
	"quest.1E4FAFA5D6C6A4F5.quest_desc": [
		"온도계로 주변 기온과 자신의 체온을 확인하세요."
	],
	"quest.58E1E10D80CF628A.title": "추위",
	"quest.58E1E10D80CF628A.quest_desc": [
		"눈 덮인 평원에 들어가면 완료됩니다. 온도계로 추위를 읽어 보세요."
	],
	"quest.45869390FA91B96A.title": "더위",
	"quest.45869390FA91B96A.quest_desc": [
		"사막에 들어가면 완료됩니다. 온도계로 더위를 읽어 보세요."
	],
	"quest.50FB8DE7E712DD51.title": "민물 얼음",
	"quest.50FB8DE7E712DD51.quest_desc": [
		"민물 얼음 양동이를 제출하세요. 눈 양동이와 둘 중 하나만 제출해도 얼음과 눈 과제를 완료할 수 있습니다."
	],
	"quest.7BDCA690CA8C5D73.title": "눈 양동이",
	"quest.7BDCA690CA8C5D73.quest_desc": [
		"눈 양동이를 제출하세요. 민물 얼음 양동이와 눈 양동이 중 하나만 제출해도 완료됩니다."
	],
	"quest.1BE60B370970C51E.title": "얼음과 눈",
	"quest.1BE60B370970C51E.quest_desc": [
		"민물 얼음 양동이 또는 눈 양동이 중 하나를 제출하면 완료됩니다. 다른 양동이는 인정되지 않습니다.",
		"직접 체크하세요."
	],
	"quest.21F9346C05BFE073.title": "온열 팩",
	"quest.21F9346C05BFE073.quest_desc": [
		"온열 팩은 몸을 데우고 한기와 동상을 완화하는 휴대용 아이템입니다."
	],
	"quest.356720F56821FF26.title": "붕대",
	"quest.356720F56821FF26.quest_desc": [
		"붕대 한 개를 제출하세요.",
		"I장이 열린 뒤(갈증의 시작 이후)에 진행합니다. 물 줄과 나란히 가도 됩니다."
	],
	"quest.793123D7C1AB65CD.title": "외상 키트",
	"quest.793123D7C1AB65CD.quest_desc": [
		"외상 키트는 붕대보다 더 많은 체력을 회복합니다."
	],
	"quest.10C1EF880E8BF9E6.title": "생존 장 마무리",
	"quest.10C1EF880E8BF9E6.quest_desc": [
		"I장을 마칩니다. 생존 번들 방이 열립니다. 체크하세요."
	]
}
