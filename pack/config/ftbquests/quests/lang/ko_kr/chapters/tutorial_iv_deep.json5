{
	"quest.372B9960F130B739.title": "장신구 슬롯",
	"quest.372B9960F130B739.quest_desc": [
		"Curios 장신구 슬롯(허리띠·목걸이·반지 등)을 열어 보세요. IV장은 앞 장을 마치지 않아도 시작할 수 있습니다. 슬롯을 연 동작은 자동 감지되지 않으므로 확인한 뒤 직접 체크하세요."
	],
	"quest.7C9CB10DFF7F9789.title": "첫 유물",
	"quest.7C9CB10DFF7F9789.quest_desc": [
		"유물 한 종류를 보유하면 완료됩니다. 우산이 아니어도 되며, Artifacts 탭의 첫 과제도 함께 진행됩니다."
	],
	"quest.4A0E53B067D449FF.title": "장착",
	"quest.4A0E53B067D449FF.quest_desc": [
		"Curios 장신구 슬롯에 유물을 장착한 뒤 체크하세요."
	],
	"quest.37A9133997CB41D1.title": "우산",
	"quest.37A9133997CB41D1.quest_desc": [
		"우산을 직접 구해 쓰임을 익히세요. 다른 유물로는 완료되지 않습니다."
	],
	"quest.462A515F57917506.title": "유물 다섯",
	"quest.462A515F57917506.quest_desc": [
		"서로 다른 유물 5종을 모은 뒤 체크하세요. 유물 도감이 열립니다."
	],
	"quest.2C5F77742A60A6EA.title": "깊은 구조물",
	"quest.2C5F77742A60A6EA.quest_desc": [
		"앞서 방문한 곳과 다른 구조물 세 곳을 추가로 탐험하세요.",
		"직접 체크하세요."
	],
	"quest.555255E094D136F2.title": "광맥",
	"quest.555255E094D136F2.quest_desc": [
		"구리 원석·철 원석·금 원석을 각각 한 개씩 제출하세요.",
		"광석 블록은 인정되지 않으며, 세 종류를 모두 제출해야 완료됩니다."
	],
	"quest.772DBBD6DB1F2AB6.title": "철 도구",
	"quest.772DBBD6DB1F2AB6.quest_desc": [
		"철 곡괭이를 제작하세요. 철 곡괭이를 얻으면 이야기 탭의 철 도구 과제도 진행됩니다."
	],
	"quest.2D5A38717478AA83.title": "바다 낚시 · 대서양 대구",
	"quest.2D5A38717478AA83.quest_desc": [
		"대서양 대구 한 마리를 제출하세요. 아래 다섯 어종 가운데 서로 다른 두 종류를 제출하면 바다 낚시 과제가 완료됩니다."
	],
	"quest.2000B3FB9060F1D4.title": "바다 낚시 · 대서양 넙치",
	"quest.2000B3FB9060F1D4.quest_desc": [
		"대서양 넙치 한 마리를 제출하세요. 아래 다섯 어종 가운데 서로 다른 두 종류를 제출하면 바다 낚시 과제가 완료됩니다."
	],
	"quest.3793744B1EF09391.title": "바다 낚시 · 붉바리",
	"quest.3793744B1EF09391.quest_desc": [
		"붉바리 한 마리를 제출하세요. 아래 다섯 어종 가운데 서로 다른 두 종류를 제출하면 바다 낚시 과제가 완료됩니다."
	],
	"quest.2A5B77132F4DD990.title": "바다 낚시 · 참치",
	"quest.2A5B77132F4DD990.quest_desc": [
		"참치 한 마리를 제출하세요. 아래 다섯 어종 가운데 서로 다른 두 종류를 제출하면 바다 낚시 과제가 완료됩니다."
	],
	"quest.2190A0BF4F37A17C.title": "바다 낚시 · 카피텐",
	"quest.2190A0BF4F37A17C.quest_desc": [
		"카피텐 한 마리를 제출하세요. 아래 다섯 어종 가운데 서로 다른 두 종류를 제출하면 바다 낚시 과제가 완료됩니다."
	],
	"quest.2CD8B3C564760599.title": "바다 낚시",
	"quest.2CD8B3C564760599.quest_desc": [
		"대서양 어종 다섯 가지 가운데 서로 다른 두 종류를 제출하면 열립니다. 모든 어종을 모을 필요는 없습니다.",
		"온대 바다·해변에서는 대서양 넙치·붉바리·참치가, 차가운 바다에서는 대서양 대구가, 건조한 지역 물가에서는 카피텐이 잡힙니다.",
		"보상으로 넵튜늄 잉곳 한 개를 받습니다. 워프스톤 두 개나 귀환 두루마리 여섯 장 같은 넵튜늄 전용 레시피에 쓸 수 있습니다.",
		"직접 체크하세요."
	],
	"quest.3E26AB2C09397E73.title": "넵튜늄",
	"quest.3E26AB2C09397E73.quest_desc": [
		"넵튜늄 잉곳 한 개를 보유하면 완료됩니다. 제출하지 않습니다.",
		"바다 낚시 보상으로 받은 잉곳으로 바로 완료할 수 있습니다. 선택 과제이며 장을 마치는 데 필요하지 않습니다.",
		"넵튜늄 레시피는 기존 재료보다 효율이 좋습니다: 워프스톤 2개, 귀환 두루마리 6장, 정수 필터 2개, 잉곳 한 개로 다이아 상자 등. JEI에서 확인하세요.",
		"추가 넵튜늄은 매우 드문 낚시 보물 상자(넵튠의 보물)에서 얻습니다."
	],
	"quest.544D8599AFBD288A.title": "넵튜늄 도구",
	"quest.544D8599AFBD288A.quest_desc": [
		"넵튜늄 도구 한 개를 보유하면 완료됩니다. 선택 과제이며 장을 마치는 데 필요하지 않습니다."
	],
	"quest.33BCBF88C712C05D.title": "넵튜늄 갑옷",
	"quest.33BCBF88C712C05D.quest_desc": [
		"넵튜늄 갑옷 한 부위를 보유하면 완료됩니다. 선택 과제이며 장을 마치는 데 필요하지 않습니다."
	],
	"quest.30AFCB65EDC66F27.title": "워프스톤",
	"quest.30AFCB65EDC66F27.quest_desc": [
		"워프스톤은 충전해 사용하는 이동 수단입니다. 기본 재료는 자수정 4·엔더 진주 4·금괴 1이며, 장미석영·넵튜늄 레시피는 JEI에서 확인하세요."
	],
	"quest.4FCC76B40788FA92.title": "워프 두루마리",
	"quest.4FCC76B40788FA92.quest_desc": [
		"워프 두루마리를 사용하면 등록한 거점 사이를 이동합니다."
	],
	"quest.2060E3828F8DE61D.title": "귀속 두루마리",
	"quest.2060E3828F8DE61D.quest_desc": [
		"귀속 두루마리로 현재 위치를 거점으로 지정하세요."
	],
	"quest.774FBFACEB9C9A37.title": "설원 탐험",
	"quest.774FBFACEB9C9A37.quest_desc": [
		"눈 덮인 타이가에 들어가면 완료됩니다. 온도계와 온열 팩을 챙기세요."
	],
	"quest.224BFEF1BD7E16D1.title": "한대 기후 상점",
	"quest.224BFEF1BD7E16D1.quest_desc": [
		"눈 덮인 지역에서 공급소 상점을 찾아 여세요. 지붕에 눈이 쌓인 가판대가 단서입니다.",
		"가죽과 양모는 식량 상점에서, 모닥불과 횃불은 무기 상점에서, 석탄은 광물 상점에서 더 비쌉니다. 숯과 얼음은 상대적으로 저렴합니다. 가격을 확인하고 직접 체크하세요. 선택 과제입니다."
	],
	"quest.0362720F2EF97E49.title": "악지 탐험",
	"quest.0362720F2EF97E49.quest_desc": [
		"악지에 들어가면 완료됩니다. 더위와 갈증이 겹치니 물과 온도계를 챙기세요."
	],
	"quest.62C9CE8381E0C4BD.title": "건조 기후 상점",
	"quest.62C9CE8381E0C4BD.quest_desc": [
		"건조 지역의 공급소 상점을 찾아 여세요. 사암 난간과 낮은 지붕이 단서입니다.",
		"물과 얼음은 물약 상점에서, 선인장은 식량 상점에서 상대적으로 저렴합니다. 증류수는 직접 만드는 편이 낫습니다. 가격을 확인하고 직접 체크하세요. 선택 과제입니다."
	],
	"quest.59FADBAAF7722C0B.title": "위험한 밤",
	"quest.59FADBAAF7722C0B.quest_desc": [
		"좀비 스무 마리를 처치하세요. 첫 좀비 처치로 모험 탭의 사냥 과제도 진행됩니다. 다른 몬스터는 처치 수에 포함되지 않습니다."
	],
	"quest.581C5DDF3449E189.title": "낚시 심화 · 조류",
	"quest.581C5DDF3449E189.quest_desc": [
		"조류를 제출하세요. 조류·거머리·유목·특수 훅 가운데 서로 다른 두 종류를 제출하면 낚시 심화 과제가 열립니다."
	],
	"quest.75289DBA1E4C1F71.title": "낚시 심화 · 거머리",
	"quest.75289DBA1E4C1F71.quest_desc": [
		"거머리를 제출하세요. 조류·거머리·유목·특수 훅 가운데 서로 다른 두 종류를 제출하면 낚시 심화 과제가 열립니다."
	],
	"quest.5D312C062D9ABB97.title": "낚시 심화 · 유목",
	"quest.5D312C062D9ABB97.quest_desc": [
		"유목을 제출하세요. 조류·거머리·유목·특수 훅 가운데 서로 다른 두 종류를 제출하면 낚시 심화 과제가 열립니다."
	],
	"quest.48F4D820DE113892.title": "낚시 심화 · 특수 훅",
	"quest.48F4D820DE113892.quest_desc": [
		"철 훅을 제외한 특수 훅을 한 번 얻으면 자동으로 완료됩니다. 훅은 제출하거나 소모하지 않습니다.",
		"조류·거머리·유목·특수 훅 가운데 서로 다른 두 가지를 마치면 낚시 심화 과제가 열립니다."
	],
	"quest.6FC639F125DA3D9E.title": "낚시 심화",
	"quest.6FC639F125DA3D9E.quest_desc": [
		"조류·거머리·유목·특수 훅 가운데 서로 다른 두 종류를 제출하면 열립니다. 다른 낚시 부산물은 인정되지 않습니다.",
		"직접 체크하세요."
	],
	"quest.49CA4687595DF2D8.title": "메디킷",
	"quest.49CA4687595DF2D8.quest_desc": [
		"체력을 크게 회복합니다. 외상 키트 2개, 금괴 4개, 황금 사과 1개로 만듭니다."
	],
	"quest.7F1562D4E3A27D9B.title": "진료소 키트",
	"quest.7F1562D4E3A27D9B.quest_desc": [
		"체력과 상태를 함께 치료합니다. 메디킷 1개, 야전 구급 키트 2개, 금괴 4개로 만듭니다.",
		"야전 구급 키트는 해독제·화상 연고·온열 팩·자극제·안약 하나씩과 상자로 만듭니다. 화상 연고에는 슬라임볼(또는 마그마 크림), 안약에는 아무 열매나 쓸 수 있습니다."
	],
	"quest.49D80AA1C5E8BB6B.title": "심층 탐험 마무리",
	"quest.49D80AA1C5E8BB6B.quest_desc": [
		"IV장을 마칩니다. 체크하세요."
	],
	"quest.640DA4CEB6AE2DFF.title": "전력 저장 장치",
	"quest.640DA4CEB6AE2DFF.quest_desc": [
		"기본 배터리는 강철·일렉트럼과 플라스틱 판이 필요합니다. 플라스틱은 나프타 정제나 생체 고분자 가공으로 마련하세요.",
		"정유·원심분리 공정을 익힌 뒤 배터리를 만들어 전력 생산과 저장을 확장하세요. IV장 이후의 선택 과제입니다."
	]
}
