{
	"quest.772B3BFFB965CBC5.title": "계절 살펴보기",
	"quest.772B3BFFB965CBC5.quest_desc": [
		"SeasonHUD(또는 화면의 계절 표시)에서 지금 계절을 확인하세요. II장은 I장을 끝내지 않아도 시작할 수 있습니다.",
		"Serene Seasons 달력은 시계(금·레드스톤)가 필요하므로 초반 필수는 아닙니다. 여유가 되면 만들어 손이나 허리띠에 장착해 보세요.",
		"직접 체크하세요."
	],
	"quest.038169815CCF4476.title": "작물과 계절",
	"quest.038169815CCF4476.quest_desc": [
		"작물마다 잘 자라는 계절이 다릅니다. JEI나 안내에서 심을 작물의 계절을 한 번 확인해 보세요.",
		"직접 체크하세요."
	],
	"quest.0B8F00E668B346A8.title": "첫 밭",
	"quest.0B8F00E668B346A8.quest_desc": [
		"땅을 갈고 물 옆에 경작지를 만드세요."
	],
	"quest.7EE4C1BFE6C08D37.title": "첫 씨앗 심기",
	"quest.7EE4C1BFE6C08D37.quest_desc": [
		"계절을 기다리지 않아도 자랄 수 있는 작물을 골라 씨앗을 심으세요. 바닐라 농사 발전과제가 완료되면 자동으로 기록됩니다.",
		"이후 작물·요리 과제에서 다양한 작물을 직접 길러 봅니다."
	],
	"quest.6DDA3882B0A7B2DB.title": "첫 다이아몬드",
	"quest.6DDA3882B0A7B2DB.quest_desc": [
		"다이아몬드 한 개를 보유하면 완료됩니다. 제출하지 않으며, 이 과제를 마치면 광물 도감이 열립니다.",
		"다이아몬드는 깊은 원정에 앞서 얻을 수 있는 초중반 자원입니다."
	],
	"quest.30D1A765A7A6C8D9.title": "새 작물: 양배추",
	"quest.30D1A765A7A6C8D9.quest_desc": [
		"이 분기에서 지정한 작물을 제출하세요.",
		"받는 종류는 양배추·토마토·양파·쌀만 인정됩니다. 서로 다른 두 종류를 제출하면 C2-05를 완료할 수 있습니다."
	],
	"quest.5D36280CB3C99A05.title": "새 작물: 토마토",
	"quest.5D36280CB3C99A05.quest_desc": [
		"이 분기에서 지정한 작물을 제출하세요.",
		"받는 종류는 양배추·토마토·양파·쌀만 인정됩니다. 서로 다른 두 종류를 제출하면 C2-05를 완료할 수 있습니다."
	],
	"quest.3196795F153655F0.title": "새 작물: 양파",
	"quest.3196795F153655F0.quest_desc": [
		"이 분기에서 지정한 작물을 제출하세요.",
		"받는 종류는 양배추·토마토·양파·쌀만 인정됩니다. 서로 다른 두 종류를 제출하면 C2-05를 완료할 수 있습니다."
	],
	"quest.40C1CEA7E92396D1.title": "새 작물: 쌀",
	"quest.40C1CEA7E92396D1.quest_desc": [
		"이 분기에서 지정한 작물을 제출하세요.",
		"받는 종류는 양배추·토마토·양파·쌀만 인정됩니다. 서로 다른 두 종류를 제출하면 C2-05를 완료할 수 있습니다."
	],
	"quest.6997797D673F4017.title": "새 작물",
	"quest.6997797D673F4017.quest_desc": [
		"양배추·토마토·양파·쌀 가운데 서로 다른 두 종류를 제출하면 완료됩니다. 다른 작물은 인정되지 않습니다.",
		"씨앗 과제에는 양배추 씨앗·토마토 씨앗·양파·쌀 중 하나가 필요합니다. 양배추나 토마토 열매만으로는 완료되지 않습니다.",
		"직접 체크하세요."
	],
	"quest.7F6E06511E1AA747.title": "도마와 칼",
	"quest.7F6E06511E1AA747.quest_desc": [
		"도마와 부싯돌 칼을 준비하세요. Farmer's Delight 탭의 칼 과제는 칼을 얻으면 진행됩니다. 수프 재료는 도마에서 손질합니다."
	],
	"quest.2242F16703752BC6.title": "스토브",
	"quest.2242F16703752BC6.quest_desc": [
		"스토브는 냄비 요리에 필요한 열원입니다."
	],
	"quest.35895D113C708AD7.title": "냄비",
	"quest.35895D113C708AD7.quest_desc": [
		"냄비를 스토브 위에 올려 수프·스튜를 끓입니다."
	],
	"quest.045FE918B0252153.title": "프라이팬",
	"quest.045FE918B0252153.quest_desc": [
		"냄비와 함께 쓰는 선택 조리 도구입니다. 재료를 굽거나 볶을 때 사용하세요. 이 장을 마치는 데 필수는 아닙니다."
	],
	"quest.2AF850BA1310B680.title": "첫 수프",
	"quest.2AF850BA1310B680.quest_desc": [
		"도마로 손질해 냄비에서 끓인 채소 수프를 제출합니다.",
		"이 과제는 채소 수프만 인정합니다. 다른 수프나 스튜로는 완료할 수 없습니다."
	],
	"quest.422C63A48C54AC97.title": "음식 책",
	"quest.422C63A48C54AC97.quest_desc": [
		"먹은 음식은 Spice of Life 음식 책에 기록됩니다."
	],
	"quest.3C73B574ED1797F4.title": "골고루 먹기",
	"quest.3C73B574ED1797F4.quest_desc": [
		"음식 책에 서로 다른 음식 10종을 기록한 뒤 체크하세요."
	],
	"quest.1E5667E2A157CC3C.title": "함께 나누는 잔치",
	"quest.1E5667E2A157CC3C.quest_desc": [
		"여럿이 나눠 먹는 잔치 블록 1종을 준비하세요."
	],
	"quest.73D93AE807F96FD4.title": "바구니와 로프",
	"quest.73D93AE807F96FD4.quest_desc": [
		"바구니와 로프는 농장에서 수확물과 재료를 다루기 편하게 해 줍니다."
	],
	"quest.5A8027D0B2281BAE.title": "울타리",
	"quest.5A8027D0B2281BAE.quest_desc": [
		"나무 종류와 관계없이 나무 울타리 16개를 준비하세요. 소·돼지·닭·양 중 2종을 그 안에 두면 목축이 시작됩니다."
	],
	"quest.63529A2914B0C8DB.title": "우유와 달걀",
	"quest.63529A2914B0C8DB.quest_desc": [
		"우유와 달걀은 요리에 쓸 수 있습니다. 선택 과제이며 이 장을 마치는 데 필요하지 않습니다."
	],
	"quest.4ADF84D844D96927.title": "가죽과 양모",
	"quest.4ADF84D844D96927.quest_desc": [
		"가죽 네 개와 아무 색 양모 네 개를 준비하세요. 선택 과제이며 이 장을 마치는 데 필요하지 않습니다."
	],
	"quest.563F65DE57A051B9.title": "낚싯대",
	"quest.563F65DE57A051B9.quest_desc": [
		"막대와 실로 만드는 바닐라 낚싯대면 충분합니다. Aquaculture 철 낚싯대는 나중에 바꿔도 됩니다.",
		"대구·연어·열대어·복어를 잡으면 농사 탭의 낚시 과제도 진행됩니다."
	],
	"quest.71792875A76E374E.title": "지렁이",
	"quest.71792875A76E374E.quest_desc": [
		"지렁이는 낚시 미끼입니다. 지렁이 농장에서 직접 기를 수도 있습니다."
	],
	"quest.66B4C79F0A58423E.title": "첫 물고기",
	"quest.66B4C79F0A58423E.quest_desc": [
		"블루길 한 마리를 제출하세요. 첫 낚시를 익히는 과제이며, 다른 물고기로 대체할 수 없습니다."
	],
	"quest.6EFF73DA49D2CF2B.title": "태클 박스",
	"quest.6EFF73DA49D2CF2B.quest_desc": [
		"낚시 도구와 미끼를 보관하는 태클 박스입니다."
	],
	"quest.3E8D8D4C58BC62A0.title": "생선 손질",
	"quest.3E8D8D4C58BC62A0.quest_desc": [
		"손질한 날생선 필렛을 제출하세요. 익힌 필렛은 다음 과제에서 필요합니다."
	],
	"quest.2644B942CBF03439.title": "익힌 필렛",
	"quest.2644B942CBF03439.quest_desc": [
		"익힌 생선 필렛을 제출하세요. 날생선 필렛이나 다른 요리는 인정되지 않습니다."
	],
	"quest.643FDDC7B5B5F90D.title": "열대의 맛",
	"quest.643FDDC7B5B5F90D.quest_desc": [
		"망고와 파인애플을 하나씩 제출하세요. 제출한 과일은 소비됩니다.",
		"음식 기록(Spice of Life)에도 남기려면 제출하기 전에 각각 하나씩 먼저 먹어 두세요."
	],
	"quest.5663A5B2801B74CC.title": "백팩",
	"quest.5663A5B2801B74CC.quest_desc": [
		"백팩으로 소지품 공간을 늘리세요. 자동 줍기나 아이템 자석은 없습니다."
	],
	"quest.271C2A4403E737A5.title": "수납 공간 늘리기",
	"quest.271C2A4403E737A5.quest_desc": [
		"업그레이드 베이스를 사용해 백팩 확장 방식을 익혀 보세요."
	],
	"quest.446030D3479C1599.title": "첫 전력원",
	"quest.446030D3479C1599.quest_desc": [
		"Oritech의 기본 발전기는 석탄 같은 일반 화로 연료로 전력을 만듭니다.",
		"농사와 부엌을 시작한 뒤 여유가 생기면 발전기와 전력 기계를 둘 작은 공방을 준비해 보세요. 이 기술 갈래는 선택 진행입니다."
	],
	"quest.77240D28128F3713.title": "전동 가공대",
	"quest.77240D28128F3713.quest_desc": [
		"전력으로 작동하는 화로를 준비하세요. 발전기와 기계의 배치는 JEI에서 확인하세요.",
		"초반부터 작은 전력망을 경험하는 단계입니다. 더 복잡한 광석 가공은 탐험과 금속 확보 뒤에 이어집니다."
	],
	"quest.03989BC73B2D1FE9.title": "부엌 장 마무리",
	"quest.03989BC73B2D1FE9.quest_desc": [
		"II장을 마칩니다. 부엌·목축 번들이 열립니다. 체크하세요."
	]
}
