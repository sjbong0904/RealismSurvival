{
	"quest.5167F344C123487C.title": "자연의 나침반",
	"quest.5167F344C123487C.quest_desc": [
		"원하는 생물군계의 방향과 거리를 알려 주는 나침반입니다. III장은 앞 장을 마치지 않아도 시작할 수 있습니다."
	],
	"quest.71BFF5F365177C73.title": "새로운 생물군계 탐험",
	"quest.71BFF5F365177C73.quest_desc": [
		"Biomes O' Plenty에서 서로 다른 생물군계 세 곳을 방문하세요."
	],
	"quest.032321EBBFC97189.title": "채집",
	"quest.032321EBBFC97189.quest_desc": [
		"이 채집물로는 종이와 워프스톤 재료를 만들 수 있습니다."
	],
	"quest.39993AD2103A9112.title": "웨이포인트 표시",
	"quest.39993AD2103A9112.quest_desc": [
		"FTB Chunks 미니맵이나 월드맵에 웨이포인트 세 곳을 표시하세요.",
		"직접 체크하세요."
	],
	"quest.6CB05A3BF43CDCD6.title": "웨이스톤으로 이동하기",
	"quest.6CB05A3BF43CDCD6.quest_desc": [
		"웨이스톤을 사용하면 활성화한 거점 사이를 빠르게 오갈 수 있습니다."
	],
	"quest.2F46A0D92C629072.title": "첫 거점",
	"quest.2F46A0D92C629072.quest_desc": [
		"웨이스톤을 설치하고 활성화하세요. 개인 거점은 보통 두 곳 정도 두면 이동에 편리합니다.",
		"직접 체크하세요."
	],
	"quest.1CE0FFC0207B6809.title": "귀환 두루마리",
	"quest.1CE0FFC0207B6809.quest_desc": [
		"한 번 사용하면 귀환 지점으로 돌아갈 수 있습니다."
	],
	"quest.207E73D71111E0DB.title": "두 번째 거점",
	"quest.207E73D71111E0DB.quest_desc": [
		"첫 거점과 다른 위치에 두 번째 웨이스톤을 설치하고 활성화하세요.",
		"직접 체크하세요."
	],
	"quest.6193F5CFFF8B487E.title": "워프스톤 예고",
	"quest.6193F5CFFF8B487E.quest_desc": [
		"워프스톤은 자수정 4·엔더 진주 4·금괴 1로 만듭니다. 웨이스톤을 세우는 데도 쓰입니다.",
		"넵튜늄 잉곳이 있으면 같은 재료로 워프스톤을 2개 만들 수 있습니다. 넵튜늄을 얻는 방법은 IV장에서 배웁니다.",
		"직접 체크하세요."
	],
	"quest.74FE5571BF67DA44.title": "길들이기",
	"quest.74FE5571BF67DA44.quest_desc": [
		"늑대 또는 고양이를 길들이면 완료됩니다.",
		"농사 탭의 길들이기 과제와 같습니다. 탭이 안 열렸으면 무언가를 한 번 먹으세요."
	],
	"quest.513164D21D4B9B6F.title": "펫 침대",
	"quest.513164D21D4B9B6F.quest_desc": [
		"Pet Home을 사용하면 펫을 맡아 두고 필요할 때 다시 부를 수 있습니다."
	],
	"quest.746E20A35BEC29CB.title": "함께 이동",
	"quest.746E20A35BEC29CB.quest_desc": [
		"웨이스톤으로 이동해 펫도 함께 따라오는지 확인하세요(Waystones Teleport Pets). 확인했으면 체크하세요."
	],
	"quest.5DBBA87F14A88282.title": "첫 구조물 탐험",
	"quest.5DBBA87F14A88282.quest_desc": [
		"Towns and Towers 구조물 한 곳을 방문한 뒤 체크하세요."
	],
	"quest.7AC42E21B9E9A1B2.title": "탑",
	"quest.7AC42E21B9E9A1B2.quest_desc": [
		"탑 한 곳을 방문한 뒤 체크하세요."
	],
	"quest.1278F1E74DEE0190.title": "전초와 폐허",
	"quest.1278F1E74DEE0190.quest_desc": [
		"전초기지와 폐허를 각각 한 곳씩 방문한 뒤 체크하세요."
	],
	"quest.299283C9FF1EB120.title": "전리품 상자",
	"quest.299283C9FF1EB120.quest_desc": [
		"Lootr 상자를 하나 여세요. 전리품은 플레이어마다 따로 생성되며 Loot 탭의 상자 과제도 함께 진행됩니다."
	],
	"quest.09D2B94CB12147AA.title": "Lootr 상자 열 개 열기",
	"quest.09D2B94CB12147AA.quest_desc": [
		"구조물을 탐험하며 Lootr 상자를 열 개 여세요. 상자를 열 때마다 진행 상황이 기록됩니다."
	],
	"quest.7C0137AA30C21551.title": "주민 거래",
	"quest.7C0137AA30C21551.quest_desc": [
		"주민과 한 번 거래하면 자동으로 완료됩니다. 마을을 둘러보며 Guard Villagers 경비병도 찾아보세요."
	],
	"quest.4C9DEC0FF6A130FA.title": "공급소",
	"quest.4C9DEC0FF6A130FA.quest_desc": [
		"분야와 관계없이 공급소 가판대 한 곳을 찾아보세요. 식량 상점은 열린 진열대, 무기 상점은 뒤쪽 작업장, 물약 상점은 벽으로 둘러싸인 방, 광물 상점은 낮은 돌담 형태입니다.",
		"가판대는 드물게 생성됩니다(온대·숲에서 가장 흔하고, 건조·한대일수록 드묾. 바다·해변에는 없음). 길을 따라 넓게 탐험하고, 찾으면 지도에 웨이포인트를 남겨 두세요. 찾으면 직접 체크하세요. 이 과제는 선택이며 장을 마치는 데 필요하지 않습니다."
	],
	"quest.2533847A36507995.title": "상인",
	"quest.2533847A36507995.quest_desc": [
		"가판대의 상인을 우클릭하면 상자 상점이 열립니다. 안에서 구매 또는 매입을 고르세요. 농부는 식량, 무기 대장은 무기, 성직자는 물약, 석공은 광물을 취급합니다.",
		"모든 상인이 공급소 품목을 매입하지만, 전문 분야의 물품은 더 높은 가격을 쳐 줍니다. 상점이 열리면 직접 체크하세요. 이 과제는 선택이며 장을 마치는 데 필요하지 않습니다."
	],
	"quest.5CB3FC25296FDC94.title": "골드",
	"quest.5CB3FC25296FDC94.quest_desc": [
		"인벤토리의 골드가 상점에서 사용하는 화폐입니다. 금 주괴와 금 조각은 제작 재료이므로 상점 화폐와 다릅니다.",
		"잔액은 인벤토리의 골드 표시나 `/coins` 명령으로 확인할 수 있습니다. 확인한 뒤 직접 체크하세요. 이 과제는 선택입니다."
	],
	"quest.4007029A92F83FB0.title": "첫 판매",
	"quest.4007029A92F83FB0.quest_desc": [
		"상인을 우클릭한 뒤 매입을 고르고, 뼈·실·썩은 살점 중 하나를 가운데 칸에 올려 보세요. 칸 색과 툴팁이 매입 여부·개당 가격·오늘 한도를 알려 주고, 아래 금 조각에 받을 금액이 표시됩니다.",
		"뼈는 식량 상인, 실은 무기 상인, 썩은 살점은 물약 상인이 더 높은 가격에 매입합니다. 상점에서 산 물건을 되팔면 손해입니다. 에메랄드를 눌러 판매를 확정한 뒤 직접 체크하세요. 이 과제는 선택입니다."
	],
	"quest.5B4FF6BF353942BF.title": "계절별 상품 확인",
	"quest.5B4FF6BF353942BF.quest_desc": [
		"SeasonHUD나 달력으로 현재 계절을 확인한 뒤, 앞서 방문한 것과 같은 분야의 상점을 다시 여세요.",
		"계절에 따라 상품 가격이 달라집니다. 제철 작물은 저렴하고, 겨울에는 가죽·연료·모닥불의 값이 오릅니다. 가격을 확인한 뒤 직접 체크하세요. 이 과제는 선택입니다."
	],
	"quest.027990763ED7073B.title": "전동 분쇄기",
	"quest.027990763ED7073B.quest_desc": [
		"전동 분쇄기로 금속 원료를 가공하는 공정을 살펴보세요. 일부 광석은 분쇄 후 제련하면 주괴 수율을 높일 수 있습니다.",
		"기계 제작에는 니켈·강철 같은 금속이 필요합니다. 아직 재료가 부족하면 탐험과 채광을 이어간 뒤 돌아오세요."
	],
	"quest.4360B9734E01BD64.title": "전력 관 연결",
	"quest.4360B9734E01BD64.quest_desc": [
		"Oritech 전력 관 여섯 개를 준비하세요. 세 개의 일렉트럼 주괴로 여섯 개를 만들 수 있습니다.",
		"발전기와 전동 분쇄기 사이에 전력 관을 연결해 기계를 가동해 보세요. 실제 배치와 전력 전달은 자동 감지되지 않아 다음 과제에서 가공 결과물을 확인합니다."
	],
	"quest.5482E963E7E6F16A.title": "첫 광석 가공",
	"quest.5482E963E7E6F16A.quest_desc": [
		"원철 한 개를 Oritech 분쇄기에 넣고 철 가루를 얻으세요. 분쇄 과정에서는 작은 철 가루도 부산물로 나옵니다.",
		"이 과제는 기계를 만드는 데서 그치지 않고 실제로 가동해 보는 선택 목표입니다."
	],
	"quest.03F636E36DC31892.title": "해독제",
	"quest.03F636E36DC31892.quest_desc": [
		"독과 독소 계열 상태이상을 치료합니다."
	],
	"quest.35213AD26A8DD536.title": "화상 연고",
	"quest.35213AD26A8DD536.quest_desc": [
		"화상과 몸에 붙은 불을 치료합니다."
	],
	"quest.03DDAFDC506EE4A7.title": "자극제",
	"quest.03DDAFDC506EE4A7.quest_desc": [
		"쇠약·한기·충격을 풀어 줍니다."
	],
	"quest.02DF28A9652C5583.title": "안약",
	"quest.02DF28A9652C5583.quest_desc": [
		"실명·어둠·멀미·공중 부양 계열을 치료합니다."
	],
	"quest.329D02F531B7F43F.title": "야전 구급 키트",
	"quest.329D02F531B7F43F.quest_desc": [
		"상태이상을 한꺼번에 치료합니다."
	],
	"quest.058C12736D5BE745.title": "탐험 장 마무리",
	"quest.058C12736D5BE745.quest_desc": [
		"III장을 마칩니다. 탐험 번들이 열립니다. 체크하세요."
	]
}
