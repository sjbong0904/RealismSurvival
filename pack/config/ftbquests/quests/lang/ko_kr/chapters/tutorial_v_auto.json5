{
	"quest.62ACC082B71D8EFC.title": "구리 상자 업그레이드",
	"quest.62ACC082B71D8EFC.quest_desc": [
		"Iron Chests 모드의 기본 상자입니다. V장은 앞 장을 마치지 않아도 시작할 수 있습니다."
	],
	"quest.305D29E406DD390E.title": "상자 업그레이드",
	"quest.305D29E406DD390E.quest_desc": [
		"상자 업그레이드로 보관 용량을 단계별로 늘려 보세요."
	],
	"quest.70335B391DBA2734.title": "철 상자",
	"quest.70335B391DBA2734.quest_desc": [
		"철 상자는 구리 상자보다 더 많은 아이템을 보관합니다."
	],
	"quest.79F0AE9686190E9D.title": "금 상자",
	"quest.79F0AE9686190E9D.quest_desc": [
		"금 상자를 보유하세요. 다이아몬드 상자는 이 과제의 조건이 아닙니다."
	],
	"quest.3CD49C8B1B5EA3A8.title": "렌치",
	"quest.3CD49C8B1B5EA3A8.quest_desc": [
		"렌치로 파이프의 연결 방향을 조정하세요."
	],
	"quest.2B304446BC54A00C.title": "아이템 파이프",
	"quest.2B304446BC54A00C.quest_desc": [
		"아이템 파이프 여덟 개를 보유하세요. 파이프 연결은 뒤의 시설 과제에서 확인합니다."
	],
	"quest.405D80A08437B9A2.title": "유체 파이프",
	"quest.405D80A08437B9A2.quest_desc": [
		"유체 파이프로 물을 탱크나 기계에 옮기세요."
	],
	"quest.6E888C55ADD03BA9.title": "속도·필터 업그레이드",
	"quest.6E888C55ADD03BA9.quest_desc": [
		"관을 더 빠르게 쓰는 선택 장비입니다.",
		"장 마무리에는 필요 없습니다. 고급·궁극 업그레이드는 목표로 두지 않습니다."
	],
	"quest.2739523D880D76B1.title": "구리 탱크",
	"quest.2739523D880D76B1.quest_desc": [
		"물을 많이 담아 두는 구리 탱크입니다."
	],
	"quest.30534F49CB803F11.title": "철 탱크",
	"quest.30534F49CB803F11.quest_desc": [
		"철 탱크는 구리 탱크보다 더 많은 물을 저장합니다."
	],
	"quest.4479935B138C17F3.title": "저장조",
	"quest.4479935B138C17F3.quest_desc": [
		"저장조는 중·후반에 대량의 물을 보관하는 시설입니다."
	],
	"quest.6DA2A9B3E5CFC27F.title": "증류 라인",
	"quest.6DA2A9B3E5CFC27F.quest_desc": [
		"증류수 병 16개를 보유하면 완료됩니다. 제출하지 않습니다.",
		"물 저장조에서 등급 물을 유체 파이프로 증류기에 공급하고, 증류 결과인 물병과 양동이는 아이템 출력구에서 호퍼나 아이템 파이프로 회수하세요. 손으로 모아도 되지만 라인을 만들면 훨씬 빠릅니다."
	],
	"quest.3C6D7E17DEAF6CED.title": "정수 라인",
	"quest.3C6D7E17DEAF6CED.quest_desc": [
		"민물 병 16개를 보유하면 완료됩니다. 제출하지 않습니다.",
		"오염된 물 양동이를 유체 파이프로 정수 필터에 넣고, 빈 병과 필터 카트리지를 넣으세요. 정수된 물병은 아이템 출력구에서 회수하며 카트리지는 소모품입니다."
	],
	"quest.3557C64F80EC8314.title": "급수 시설",
	"quest.3557C64F80EC8314.quest_desc": [
		"증류수 양동이 4개를 보유하면 완료됩니다. 제출하지 않습니다.",
		"저장조에 증류수를 모아 두고 필요할 때 양동이나 물병으로 꺼내 쓰세요. 꾸준한 식수 공급을 위한 기반 시설입니다."
	],
	"quest.512AAE6A5E05FF27.title": "소금 공정",
	"quest.512AAE6A5E05FF27.quest_desc": [
		"소금 32개를 보유하면 완료됩니다. 제출하지 않습니다.",
		"바닷물을 증류기에 넣으면 증류수와 함께 소금이 나옵니다. 바닷물 → 증류기 → 소금 회수 라인을 만들어 보세요."
	],
	"quest.4B21F5A24114FD21.title": "부엌 연결",
	"quest.4B21F5A24114FD21.quest_desc": [
		"상자와 파이프를 연결해 부엌에 필요한 재료를 공급하세요.",
		"직접 체크하세요."
	],
	"quest.338F53CBF816ADAD.title": "수확물 모으기",
	"quest.338F53CBF816ADAD.quest_desc": [
		"수확물이 상자에 자동으로 모이도록 연결하세요.",
		"직접 체크하세요."
	],
	"quest.0842462F9A62C823.title": "백팩 확장",
	"quest.0842462F9A62C823.quest_desc": [
		"철 백팩을 보유하면 완료됩니다. 구리 백팩을 업그레이드하거나 직접 제작하세요.",
		"수납 공간 확장 업그레이드도 함께 써 보세요. 자석과 자동 줍기 업그레이드는 사용하지 않습니다."
	],
	"quest.20C6A855D971E0C7.title": "자동화 장 마무리",
	"quest.20C6A855D971E0C7.quest_desc": [
		"V장·튜토리얼을 마칩니다. 인장과 도감 마무리 단계로 가세요. 체크하세요."
	],
	"quest.3059BE8DE14E8D4D.title": "전력 공방 연결",
	"quest.3059BE8DE14E8D4D.quest_desc": [
		"초중반에 준비한 Oritech 발전기·전력 관·분쇄기를 급수·부엌·수확물 보관 시설과 연결해 보세요.",
		"전동 기계와 수송 시설이 실제로 작동하고 필요한 재료가 공방에 모이면 체크하세요. 배치와 작동 상태는 자동 감지되지 않습니다. 선택 과제입니다.",
		"기본 자동화 장을 끝낸 뒤 더 큰 공방을 확장하는 후반 프로젝트입니다. 핵분열·입자가속기·대규모 채석은 필수 목표로 두지 않습니다."
	],
	"quest.3C1301788B81ED97.title": "심부 자원 탐지기",
	"quest.3C1301788B81ED97.quest_desc": [
		"자원 노드 공명기는 전력을 충전해 주변에 로드된 청크의 심부 자원 노드를 찾습니다.",
		"지표의 광석 바위는 베드락 아래 자원 노드의 위치를 알려 주는 표식입니다. 탐지 범위와 충전량을 확인하며 찾으세요. 선택 후반 과제입니다."
	],
	"quest.46D063E9E931F815.title": "베드락 채굴기",
	"quest.46D063E9E931F815.quest_desc": [
		"베드락 채굴기는 자원 노드에서 원료를 지속적으로 채취하는 고급 설비입니다.",
		"희귀 금속과 고급 부품이 필요한 선택 후반 목표입니다. 설치와 가동에는 충분한 전력망을 준비하세요."
	]
}
