	"quest.4315CD08E6B9602A.title": "철 원석",
	"quest.4315CD08E6B9602A.quest_desc": [
		"철 원석 여덟 개를 제출하세요.",
		"오버월드 하루 동안 골드 보상은 최대 3건입니다. 과제는 더 할 수 있지만 보상은 한도까지만 받습니다."
	],
	"quest.16805CA750A56CF0.title": "갈증의 시작",
	"quest.16805CA750A56CF0.quest_desc": [
		"갈증 수치가 시간에 따라 줄어듭니다. I장은 0장을 끝내지 않아도 시작할 수 있습니다.",
		"직접 체크하세요."
	],
	"quest.1F2C60E5F492F7F7.title": "물에도 등급이 있다",
	"quest.1F2C60E5F492F7F7.quest_desc": [
		"JEI에서 증류수·민물·오염된 물·바닷물 병과 양동이를 확인해 보세요.",
		"증류수는 갈증을 40 회복하고, 민물과 오염된 물은 20 회복합니다. 바닷물은 갈증을 14 낮춥니다.",
		"직접 체크하세요."
	],
	"quest.7F6A12BCDD461FBC.title": "오염된 물 한 양동이",
	"quest.7F6A12BCDD461FBC.quest_desc": [
		"월드에 고여 있는 물은 대부분 오염된 물입니다. 마시기 전에 등급을 확인하세요."
	],
	"quest.6CC88228A9A8BEE4.title": "바닷물",
	"quest.6CC88228A9A8BEE4.quest_desc": [
		"바닷물은 마시는 물이 아니라 소금의 재료입니다."
	],
	"quest.180334DE39A061A4.title": "민물 한 병",
	"quest.180334DE39A061A4.quest_desc": [
		"민물은 마실 수 있으며, 갈증을 20 회복합니다."
	],
	"quest.1004C3F401989E5B.title": "민물 마시기",
	"quest.1004C3F401989E5B.quest_desc": [
		"민물 병 한 개를 제출하면 완료됩니다. 제출한 병은 소비됩니다.",
		"제출과 별개로 민물 병을 하나 더 마셔 갈증이 20 회복되는지 확인해 보세요. 강가에서 맨손으로 마시는 물은 병보다 훨씬 적게 회복합니다."
	],
	"quest.4AC76AF1FF3A1545.title": "불씨",
	"quest.4AC76AF1FF3A1545.quest_desc": [
		"증류기를 돌릴 화로를 준비하세요."
	],
	"quest.5A4554C0626A3F6C.title": "증류기",
	"quest.5A4554C0626A3F6C.quest_desc": [
		"증류기로 물을 끓여 증류수로 만드세요."
	],
	"quest.7E39F4B86338AFE6.title": "첫 증류수",
	"quest.7E39F4B86338AFE6.quest_desc": [
		"증류수 병 세 개를 제출하세요. 증류수는 갈증을 40 회복합니다. 다른 등급의 물은 인정되지 않습니다."
	],
	"quest.30809E75BF07E369.title": "정수 필터",
	"quest.30809E75BF07E369.quest_desc": [
		"정수 필터로 물을 거르면 민물 병을 얻습니다."
	],
	"quest.5931B14D8516EFFE.title": "필터 카트리지",
	"quest.5931B14D8516EFFE.quest_desc": [
		"필터 카트리지는 사용할수록 닳습니다. 정수 기능을 유지하려면 새 카트리지로 교체하세요."
	],
	"quest.715BB8259B11F742.title": "필터로 정수하기",
	"quest.715BB8259B11F742.quest_desc": [
		"정수 필터로 만든 민물 병 세 개를 제출하세요. 증류수나 오염된 물은 인정되지 않습니다."
	],
	"quest.6E84A458941768A9.title": "물 비축",
	"quest.6E84A458941768A9.quest_desc": [
		"탐험을 떠나기 전에 마실 물을 챙기세요. 제출하지 않고 보유 여부만 확인하는 과제입니다."
	],
	"quest.2140E3AD1708060E.title": "바닷물에서 소금 얻기",
	"quest.2140E3AD1708060E.quest_desc": [
		"소금 네 개를 제출하세요. 바닷물 양동이를 증류기에 넣으면 소금이 부산물로 나옵니다."
	],
	"quest.4FAEE362E469342B.title": "소금 보관하기",
	"quest.4FAEE362E469342B.quest_desc": [
		"소금 블록은 소금을 보관하거나 건축 재료로 쓸 수 있습니다."
	],
	"quest.1E4FAFA5D6C6A4F5.title": "온도계",
	"quest.1E4FAFA5D6C6A4F5.quest_desc": [
		"온도계로 주변 기온과 자신의 체온을 확인하세요."
	],
	"quest.58E1E10D80CF628A.title": "추위",
	"quest.58E1E10D80CF628A.quest_desc": [
		"눈 덮인 평원에 들어가면 완료됩니다. 온도계로 추위를 읽어 보세요."
	],
	"quest.45869390FA91B96A.title": "더위",
	"quest.45869390FA91B96A.quest_desc": [
		"사막에 들어가면 완료됩니다. 온도계로 더위를 읽어 보세요."
	],
	"quest.50FB8DE7E712DD51.title": "민물 얼음",
	"quest.50FB8DE7E712DD51.quest_desc": [
		"민물 얼음 양동이를 제출하세요. 눈 양동이와 둘 중 하나만 제출해도 얼음과 눈 과제를 완료할 수 있습니다."
	],
	"quest.7BDCA690CA8C5D73.title": "눈 양동이",
	"quest.7BDCA690CA8C5D73.quest_desc": [
		"눈 양동이를 제출하세요. 민물 얼음 양동이와 눈 양동이 중 하나만 제출해도 완료됩니다."
	],
	"quest.1BE60B370970C51E.title": "얼음과 눈",
	"quest.1BE60B370970C51E.quest_desc": [
		"민물 얼음 양동이 또는 눈 양동이 중 하나를 제출하면 완료됩니다. 다른 양동이는 인정되지 않습니다.",
		"직접 체크하세요."
	],
	"quest.21F9346C05BFE073.title": "온열 팩",
	"quest.21F9346C05BFE073.quest_desc": [
		"온열 팩은 몸을 데우고 한기와 동상을 완화하는 휴대용 아이템입니다."
	],
	"quest.356720F56821FF26.title": "붕대",
	"quest.356720F56821FF26.quest_desc": [
		"붕대 한 개를 제출하세요.",
		"I장이 열린 뒤(갈증의 시작 이후)에 진행합니다. 물 줄과 나란히 가도 됩니다."
	],
	"quest.793123D7C1AB65CD.title": "외상 키트",
	"quest.793123D7C1AB65CD.quest_desc": [
		"외상 키트는 붕대보다 더 많은 체력을 회복합니다."
	],
	"quest.10C1EF880E8BF9E6.title": "생존 장 마무리",
	"quest.10C1EF880E8BF9E6.quest_desc": [
		"I장을 마칩니다. 생존 번들 방이 열립니다. 체크하세요."
	],
	"quest.772B3BFFB965CBC5.title": "계절 살펴보기",
	"quest.772B3BFFB965CBC5.quest_desc": [
		"SeasonHUD(또는 화면의 계절 표시)에서 지금 계절을 확인하세요. II장은 I장을 끝내지 않아도 시작할 수 있습니다.",
		"Serene Seasons 달력은 시계(금·레드스톤)가 필요하므로 초반 필수는 아닙니다. 여유가 되면 만들어 손이나 허리띠에 장착해 보세요.",
		"직접 체크하세요."
	],
	"quest.038169815CCF4476.title": "작물과 계절",
	"quest.038169815CCF4476.quest_desc": [
		"작물마다 잘 자라는 계절이 다릅니다. JEI나 안내에서 심을 작물의 계절을 한 번 확인해 보세요.",
		"직접 체크하세요."
	],
	"quest.0B8F00E668B346A8.title": "첫 밭",
	"quest.0B8F00E668B346A8.quest_desc": [
		"땅을 갈고 물 옆에 경작지를 만드세요."
	],
	"quest.7EE4C1BFE6C08D37.title": "첫 씨앗 심기",
	"quest.7EE4C1BFE6C08D37.quest_desc": [
		"계절을 기다리지 않아도 자랄 수 있는 작물을 골라 씨앗을 심으세요. 바닐라 농사 발전과제가 완료되면 자동으로 기록됩니다.",
		"이후 작물·요리 과제에서 다양한 작물을 직접 길러 봅니다."
	],
	"quest.6DDA3882B0A7B2DB.title": "첫 다이아몬드",
	"quest.6DDA3882B0A7B2DB.quest_desc": [
		"다이아몬드 한 개를 보유하면 완료됩니다. 제출하지 않으며, 이 과제를 마치면 광물 도감이 열립니다.",
		"다이아몬드는 깊은 원정에 앞서 얻을 수 있는 초중반 자원입니다."
	],
	"quest.30D1A765A7A6C8D9.title": "새 작물: 양배추",
	"quest.30D1A765A7A6C8D9.quest_desc": [
		"이 분기에서 지정한 작물을 제출하세요.",
		"받는 종류는 양배추·토마토·양파·쌀만 인정됩니다. 서로 다른 두 종류를 제출하면 C2-05를 완료할 수 있습니다."
	],
	"quest.5D36280CB3C99A05.title": "새 작물: 토마토",
	"quest.5D36280CB3C99A05.quest_desc": [
		"이 분기에서 지정한 작물을 제출하세요.",
		"받는 종류는 양배추·토마토·양파·쌀만 인정됩니다. 서로 다른 두 종류를 제출하면 C2-05를 완료할 수 있습니다."
	],
	"quest.3196795F153655F0.title": "새 작물: 양파",
	"quest.3196795F153655F0.quest_desc": [
		"이 분기에서 지정한 작물을 제출하세요.",
		"받는 종류는 양배추·토마토·양파·쌀만 인정됩니다. 서로 다른 두 종류를 제출하면 C2-05를 완료할 수 있습니다."
	],
	"quest.40C1CEA7E92396D1.title": "새 작물: 쌀",
	"quest.40C1CEA7E92396D1.quest_desc": [
		"이 분기에서 지정한 작물을 제출하세요.",
		"받는 종류는 양배추·토마토·양파·쌀만 인정됩니다. 서로 다른 두 종류를 제출하면 C2-05를 완료할 수 있습니다."
	],
	"quest.6997797D673F4017.title": "새 작물",
	"quest.6997797D673F4017.quest_desc": [
		"양배추·토마토·양파·쌀 가운데 서로 다른 두 종류를 제출하면 완료됩니다. 다른 작물은 인정되지 않습니다.",
		"씨앗 과제에는 양배추 씨앗·토마토 씨앗·양파·쌀 중 하나가 필요합니다. 양배추나 토마토 열매만으로는 완료되지 않습니다.",
		"직접 체크하세요."
	],
	"quest.7F6E06511E1AA747.title": "도마와 칼",
	"quest.7F6E06511E1AA747.quest_desc": [
		"도마와 부싯돌 칼을 준비하세요. Farmer's Delight 탭의 칼 과제는 칼을 얻으면 진행됩니다. 수프 재료는 도마에서 손질합니다."
	],
	"quest.2242F16703752BC6.title": "스토브",
	"quest.2242F16703752BC6.quest_desc": [
		"스토브는 냄비 요리에 필요한 열원입니다."
	],
	"quest.35895D113C708AD7.title": "냄비",
	"quest.35895D113C708AD7.quest_desc": [
		"냄비를 스토브 위에 올려 수프·스튜를 끓입니다."
	],
	"quest.045FE918B0252153.title": "프라이팬",
	"quest.045FE918B0252153.quest_desc": [
		"냄비와 함께 쓰는 선택 조리 도구입니다. 재료를 굽거나 볶을 때 사용하세요. 이 장을 마치는 데 필수는 아닙니다."
	],
	"quest.2AF850BA1310B680.title": "첫 수프",
	"quest.2AF850BA1310B680.quest_desc": [
		"도마로 손질해 냄비에서 끓인 채소 수프를 제출합니다.",
		"이 과제는 채소 수프만 인정합니다. 다른 수프나 스튜로는 완료할 수 없습니다."
	],
	"quest.422C63A48C54AC97.title": "음식 책",
	"quest.422C63A48C54AC97.quest_desc": [
		"먹은 음식은 Spice of Life 음식 책에 기록됩니다."
	],
	"quest.3C73B574ED1797F4.title": "골고루 먹기",
	"quest.3C73B574ED1797F4.quest_desc": [
		"음식 책에 서로 다른 음식 10종을 기록한 뒤 체크하세요."
	],
	"quest.1E5667E2A157CC3C.title": "함께 나누는 잔치",
	"quest.1E5667E2A157CC3C.quest_desc": [
		"여럿이 나눠 먹는 잔치 블록 1종을 준비하세요."
	],
	"quest.73D93AE807F96FD4.title": "바구니와 로프",
	"quest.73D93AE807F96FD4.quest_desc": [
		"바구니와 로프는 농장에서 수확물과 재료를 다루기 편하게 해 줍니다."
	],
	"quest.5A8027D0B2281BAE.title": "울타리",
	"quest.5A8027D0B2281BAE.quest_desc": [
		"나무 종류와 관계없이 나무 울타리 16개를 준비하세요. 소·돼지·닭·양 중 2종을 그 안에 두면 목축이 시작됩니다."
	],
	"quest.63529A2914B0C8DB.title": "우유와 달걀",
	"quest.63529A2914B0C8DB.quest_desc": [
		"우유와 달걀은 요리에 쓸 수 있습니다. 선택 과제이며 이 장을 마치는 데 필요하지 않습니다."
	],
	"quest.4ADF84D844D96927.title": "가죽과 양모",
	"quest.4ADF84D844D96927.quest_desc": [
		"가죽 네 개와 아무 색 양모 네 개를 준비하세요. 선택 과제이며 이 장을 마치는 데 필요하지 않습니다."
	],
	"quest.563F65DE57A051B9.title": "낚싯대",
	"quest.563F65DE57A051B9.quest_desc": [
		"막대와 실로 만드는 바닐라 낚싯대면 충분합니다. Aquaculture 철 낚싯대는 나중에 바꿔도 됩니다.",
		"대구·연어·열대어·복어를 잡으면 농사 탭의 낚시 과제도 진행됩니다."
	],
	"quest.71792875A76E374E.title": "지렁이",
	"quest.71792875A76E374E.quest_desc": [
		"지렁이는 낚시 미끼입니다. 지렁이 농장에서 직접 기를 수도 있습니다."
	],
	"quest.66B4C79F0A58423E.title": "첫 물고기",
	"quest.66B4C79F0A58423E.quest_desc": [
		"블루길 한 마리를 제출하세요. 첫 낚시를 익히는 과제이며, 다른 물고기로 대체할 수 없습니다."
	],
	"quest.6EFF73DA49D2CF2B.title": "태클 박스",
	"quest.6EFF73DA49D2CF2B.quest_desc": [
		"낚시 도구와 미끼를 보관하는 태클 박스입니다."
	],
	"quest.3E8D8D4C58BC62A0.title": "생선 손질",
	"quest.3E8D8D4C58BC62A0.quest_desc": [
		"손질한 날생선 필렛을 제출하세요. 익힌 필렛은 다음 과제에서 필요합니다."
	],
	"quest.2644B942CBF03439.title": "익힌 필렛",
	"quest.2644B942CBF03439.quest_desc": [
		"익힌 생선 필렛을 제출하세요. 날생선 필렛이나 다른 요리는 인정되지 않습니다."
	],
	"quest.643FDDC7B5B5F90D.title": "열대의 맛",
	"quest.643FDDC7B5B5F90D.quest_desc": [
		"망고와 파인애플을 하나씩 제출하세요. 제출한 과일은 소비됩니다.",
		"음식 기록(Spice of Life)에도 남기려면 제출하기 전에 각각 하나씩 먼저 먹어 두세요."
	],
	"quest.5663A5B2801B74CC.title": "백팩",
	"quest.5663A5B2801B74CC.quest_desc": [
		"백팩으로 소지품 공간을 늘리세요. 자동 줍기나 아이템 자석은 없습니다."
	],
	"quest.271C2A4403E737A5.title": "수납 공간 늘리기",
	"quest.271C2A4403E737A5.quest_desc": [
		"업그레이드 베이스를 사용해 백팩 확장 방식을 익혀 보세요."
	],
	"quest.446030D3479C1599.title": "첫 전력원",
	"quest.446030D3479C1599.quest_desc": [
		"Oritech의 기본 발전기는 석탄 같은 일반 화로 연료로 전력을 만듭니다.",
		"농사와 부엌을 시작한 뒤 여유가 생기면 발전기와 전력 기계를 둘 작은 공방을 준비해 보세요. 이 기술 갈래는 선택 진행입니다."
	],
	"quest.77240D28128F3713.title": "전동 가공대",
	"quest.77240D28128F3713.quest_desc": [
		"전력으로 작동하는 화로를 준비하세요. 발전기와 기계의 배치는 JEI에서 확인하세요.",
		"초반부터 작은 전력망을 경험하는 단계입니다. 더 복잡한 광석 가공은 탐험과 금속 확보 뒤에 이어집니다."
	],
	"quest.03989BC73B2D1FE9.title": "부엌 장 마무리",
	"quest.03989BC73B2D1FE9.quest_desc": [
		"II장을 마칩니다. 부엌·목축 번들이 열립니다. 체크하세요."
	],
	"quest.5167F344C123487C.title": "자연의 나침반",
	"quest.5167F344C123487C.quest_desc": [
		"원하는 생물군계의 방향과 거리를 알려 주는 나침반입니다. III장은 앞 장을 마치지 않아도 시작할 수 있습니다."
	],
	"quest.71BFF5F365177C73.title": "새로운 생물군계 탐험",
	"quest.71BFF5F365177C73.quest_desc": [
		"Biomes O' Plenty에서 서로 다른 생물군계 세 곳을 방문하세요."
	],
	"quest.032321EBBFC97189.title": "채집",
	"quest.032321EBBFC97189.quest_desc": [
		"이 채집물로는 종이와 워프스톤 재료를 만들 수 있습니다."
	],
	"quest.39993AD2103A9112.title": "웨이포인트 표시",
	"quest.39993AD2103A9112.quest_desc": [
		"FTB Chunks 미니맵이나 월드맵에 웨이포인트 세 곳을 표시하세요.",
		"직접 체크하세요."
	],
	"quest.6CB05A3BF43CDCD6.title": "웨이스톤으로 이동하기",
	"quest.6CB05A3BF43CDCD6.quest_desc": [
		"웨이스톤을 사용하면 활성화한 거점 사이를 빠르게 오갈 수 있습니다."
	],
	"quest.2F46A0D92C629072.title": "첫 거점",
	"quest.2F46A0D92C629072.quest_desc": [
		"웨이스톤을 설치하고 활성화하세요. 개인 거점은 보통 두 곳 정도 두면 이동에 편리합니다.",
		"직접 체크하세요."
	],
	"quest.1CE0FFC0207B6809.title": "귀환 두루마리",
	"quest.1CE0FFC0207B6809.quest_desc": [
		"한 번 사용하면 귀환 지점으로 돌아갈 수 있습니다."
	],
	"quest.207E73D71111E0DB.title": "두 번째 거점",
	"quest.207E73D71111E0DB.quest_desc": [
		"첫 거점과 다른 위치에 두 번째 웨이스톤을 설치하고 활성화하세요.",
		"직접 체크하세요."
	],
	"quest.6193F5CFFF8B487E.title": "워프스톤 예고",
	"quest.6193F5CFFF8B487E.quest_desc": [
		"워프스톤은 자수정 4·엔더 진주 4·금괴 1로 만듭니다. 웨이스톤을 세우는 데도 쓰입니다.",
		"넵튜늄 잉곳이 있으면 같은 재료로 워프스톤을 2개 만들 수 있습니다. 넵튜늄을 얻는 방법은 IV장에서 배웁니다.",
		"직접 체크하세요."
	],
	"quest.74FE5571BF67DA44.title": "길들이기",
	"quest.74FE5571BF67DA44.quest_desc": [
		"늑대 또는 고양이를 길들이면 완료됩니다.",
		"농사 탭의 길들이기 과제와 같습니다. 탭이 안 열렸으면 무언가를 한 번 먹으세요."
	],
	"quest.513164D21D4B9B6F.title": "펫 침대",
	"quest.513164D21D4B9B6F.quest_desc": [
		"Pet Home을 사용하면 펫을 맡아 두고 필요할 때 다시 부를 수 있습니다."
	],
	"quest.746E20A35BEC29CB.title": "함께 이동",
	"quest.746E20A35BEC29CB.quest_desc": [
		"웨이스톤으로 이동해 펫도 함께 따라오는지 확인하세요(Waystones Teleport Pets). 확인했으면 체크하세요."
	],
	"quest.5DBBA87F14A88282.title": "첫 구조물 탐험",
	"quest.5DBBA87F14A88282.quest_desc": [
		"Towns and Towers 구조물 한 곳을 방문한 뒤 체크하세요."
	],
	"quest.7AC42E21B9E9A1B2.title": "탑",
	"quest.7AC42E21B9E9A1B2.quest_desc": [
		"탑 한 곳을 방문한 뒤 체크하세요."
	],
	"quest.1278F1E74DEE0190.title": "전초와 폐허",
	"quest.1278F1E74DEE0190.quest_desc": [
		"전초기지와 폐허를 각각 한 곳씩 방문한 뒤 체크하세요."
	],
	"quest.299283C9FF1EB120.title": "전리품 상자",
	"quest.299283C9FF1EB120.quest_desc": [
		"Lootr 상자를 하나 여세요. 전리품은 플레이어마다 따로 생성되며 Loot 탭의 상자 과제도 함께 진행됩니다."
	],
	"quest.09D2B94CB12147AA.title": "Lootr 상자 열 개 열기",
	"quest.09D2B94CB12147AA.quest_desc": [
		"구조물을 탐험하며 Lootr 상자를 열 개 여세요. 상자를 열 때마다 진행 상황이 기록됩니다."
	],
	"quest.7C0137AA30C21551.title": "주민 거래",
	"quest.7C0137AA30C21551.quest_desc": [
		"주민과 한 번 거래하면 자동으로 완료됩니다. 마을을 둘러보며 Guard Villagers 경비병도 찾아보세요."
	],
	"quest.4C9DEC0FF6A130FA.title": "공급소",
	"quest.4C9DEC0FF6A130FA.quest_desc": [
		"분야와 관계없이 공급소 가판대 한 곳을 찾아보세요. 식량 상점은 열린 진열대, 무기 상점은 뒤쪽 작업장, 물약 상점은 벽으로 둘러싸인 방, 광물 상점은 낮은 돌담 형태입니다.",
		"가판대는 드물게 생성됩니다(온대·숲에서 가장 흔하고, 건조·한대일수록 드묾. 바다·해변에는 없음). 길을 따라 넓게 탐험하고, 찾으면 지도에 웨이포인트를 남겨 두세요. 찾으면 직접 체크하세요. 이 과제는 선택이며 장을 마치는 데 필요하지 않습니다."
	],
	"quest.2533847A36507995.title": "상인",
	"quest.2533847A36507995.quest_desc": [
		"가판대의 상인을 우클릭하면 상자 상점이 열립니다. 안에서 구매 또는 매입을 고르세요. 농부는 식량, 무기 대장은 무기, 성직자는 물약, 석공은 광물을 취급합니다.",
		"모든 상인이 공급소 품목을 매입하지만, 전문 분야의 물품은 더 높은 가격을 쳐 줍니다. 상점이 열리면 직접 체크하세요. 이 과제는 선택이며 장을 마치는 데 필요하지 않습니다."
	],
	"quest.5CB3FC25296FDC94.title": "골드",
	"quest.5CB3FC25296FDC94.quest_desc": [
		"인벤토리의 골드가 상점에서 사용하는 화폐입니다. 금 주괴와 금 조각은 제작 재료이므로 상점 화폐와 다릅니다.",
		"잔액은 인벤토리의 골드 표시나 `/coins` 명령으로 확인할 수 있습니다. 확인한 뒤 직접 체크하세요. 이 과제는 선택입니다."
	],
	"quest.4007029A92F83FB0.title": "첫 판매",
	"quest.4007029A92F83FB0.quest_desc": [
		"상인을 우클릭한 뒤 매입을 고르고, 뼈·실·썩은 살점 중 하나를 가운데 칸에 올려 보세요. 칸 색과 툴팁이 매입 여부·개당 가격·오늘 한도를 알려 주고, 아래 금 조각에 받을 금액이 표시됩니다.",
		"뼈는 식량 상인, 실은 무기 상인, 썩은 살점은 물약 상인이 더 높은 가격에 매입합니다. 상점에서 산 물건을 되팔면 손해입니다. 에메랄드를 눌러 판매를 확정한 뒤 직접 체크하세요. 이 과제는 선택입니다."
	],
	"quest.5B4FF6BF353942BF.title": "계절별 상품 확인",
	"quest.5B4FF6BF353942BF.quest_desc": [
		"SeasonHUD나 달력으로 현재 계절을 확인한 뒤, 앞서 방문한 것과 같은 분야의 상점을 다시 여세요.",
		"계절에 따라 상품 가격이 달라집니다. 제철 작물은 저렴하고, 겨울에는 가죽·연료·모닥불의 값이 오릅니다. 가격을 확인한 뒤 직접 체크하세요. 이 과제는 선택입니다."
	],
	"quest.027990763ED7073B.title": "전동 분쇄기",
	"quest.027990763ED7073B.quest_desc": [
		"전동 분쇄기로 금속 원료를 가공하는 공정을 살펴보세요. 일부 광석은 분쇄 후 제련하면 주괴 수율을 높일 수 있습니다.",
		"기계 제작에는 니켈·강철 같은 금속이 필요합니다. 아직 재료가 부족하면 탐험과 채광을 이어간 뒤 돌아오세요."
	],
	"quest.4360B9734E01BD64.title": "전력 관 연결",
	"quest.4360B9734E01BD64.quest_desc": [
		"Oritech 전력 관 여섯 개를 준비하세요. 세 개의 일렉트럼 주괴로 여섯 개를 만들 수 있습니다.",
		"발전기와 전동 분쇄기 사이에 전력 관을 연결해 기계를 가동해 보세요. 실제 배치와 전력 전달은 자동 감지되지 않아 다음 과제에서 가공 결과물을 확인합니다."
	],
	"quest.5482E963E7E6F16A.title": "첫 광석 가공",
	"quest.5482E963E7E6F16A.quest_desc": [
		"원철 한 개를 Oritech 분쇄기에 넣고 철 가루를 얻으세요. 분쇄 과정에서는 작은 철 가루도 부산물로 나옵니다.",
		"이 과제는 기계를 만드는 데서 그치지 않고 실제로 가동해 보는 선택 목표입니다."
	],
	"quest.03F636E36DC31892.title": "해독제",
	"quest.03F636E36DC31892.quest_desc": [
		"독과 독소 계열 상태이상을 치료합니다."
	],
	"quest.35213AD26A8DD536.title": "화상 연고",
	"quest.35213AD26A8DD536.quest_desc": [
		"화상과 몸에 붙은 불을 치료합니다."
	],
	"quest.03DDAFDC506EE4A7.title": "자극제",
	"quest.03DDAFDC506EE4A7.quest_desc": [
		"쇠약·한기·충격을 풀어 줍니다."
	],
	"quest.02DF28A9652C5583.title": "안약",
	"quest.02DF28A9652C5583.quest_desc": [
		"실명·어둠·멀미·공중 부양 계열을 치료합니다."
	],
	"quest.329D02F531B7F43F.title": "야전 구급 키트",
	"quest.329D02F531B7F43F.quest_desc": [
		"상태이상을 한꺼번에 치료합니다."
	],
	"quest.058C12736D5BE745.title": "탐험 장 마무리",
	"quest.058C12736D5BE745.quest_desc": [
		"III장을 마칩니다. 탐험 번들이 열립니다. 체크하세요."
	],
	"quest.372B9960F130B739.title": "장신구 슬롯",
	"quest.372B9960F130B739.quest_desc": [
		"Curios 장신구 슬롯(허리띠·목걸이·반지 등)을 열어 보세요. IV장은 앞 장을 마치지 않아도 시작할 수 있습니다. 슬롯을 연 동작은 자동 감지되지 않으므로 확인한 뒤 직접 체크하세요."
	],
	"quest.7C9CB10DFF7F9789.title": "첫 유물",
	"quest.7C9CB10DFF7F9789.quest_desc": [
		"유물 한 종류를 보유하면 완료됩니다. 우산이 아니어도 되며, Artifacts 탭의 첫 과제도 함께 진행됩니다."
	],
	"quest.4A0E53B067D449FF.title": "장착",
	"quest.4A0E53B067D449FF.quest_desc": [
		"Curios 장신구 슬롯에 유물을 장착한 뒤 체크하세요."
	],
	"quest.37A9133997CB41D1.title": "우산",
	"quest.37A9133997CB41D1.quest_desc": [
		"우산을 직접 구해 쓰임을 익히세요. 다른 유물로는 완료되지 않습니다."
	],
	"quest.462A515F57917506.title": "유물 다섯",
	"quest.462A515F57917506.quest_desc": [
		"서로 다른 유물 5종을 모은 뒤 체크하세요. 유물 도감이 열립니다."
	],
	"quest.2C5F77742A60A6EA.title": "깊은 구조물",
	"quest.2C5F77742A60A6EA.quest_desc": [
		"앞서 방문한 곳과 다른 구조물 세 곳을 추가로 탐험하세요.",
		"직접 체크하세요."
	],
	"quest.555255E094D136F2.title": "광맥",
	"quest.555255E094D136F2.quest_desc": [
		"구리 원석·철 원석·금 원석을 각각 한 개씩 제출하세요.",
		"광석 블록은 인정되지 않으며, 세 종류를 모두 제출해야 완료됩니다."
	],
	"quest.772DBBD6DB1F2AB6.title": "철 도구",
	"quest.772DBBD6DB1F2AB6.quest_desc": [
		"철 곡괭이를 제작하세요. 철 곡괭이를 얻으면 이야기 탭의 철 도구 과제도 진행됩니다."
	],
	"quest.2D5A38717478AA83.title": "바다 낚시 · 대서양 대구",
	"quest.2D5A38717478AA83.quest_desc": [
		"대서양 대구 한 마리를 제출하세요. 아래 다섯 어종 가운데 서로 다른 두 종류를 제출하면 바다 낚시 과제가 완료됩니다."
	],
	"quest.2000B3FB9060F1D4.title": "바다 낚시 · 대서양 넙치",
	"quest.2000B3FB9060F1D4.quest_desc": [
		"대서양 넙치 한 마리를 제출하세요. 아래 다섯 어종 가운데 서로 다른 두 종류를 제출하면 바다 낚시 과제가 완료됩니다."
	],
	"quest.3793744B1EF09391.title": "바다 낚시 · 붉바리",
	"quest.3793744B1EF09391.quest_desc": [
		"붉바리 한 마리를 제출하세요. 아래 다섯 어종 가운데 서로 다른 두 종류를 제출하면 바다 낚시 과제가 완료됩니다."
	],
	"quest.2A5B77132F4DD990.title": "바다 낚시 · 참치",
	"quest.2A5B77132F4DD990.quest_desc": [
		"참치 한 마리를 제출하세요. 아래 다섯 어종 가운데 서로 다른 두 종류를 제출하면 바다 낚시 과제가 완료됩니다."
	],
	"quest.2190A0BF4F37A17C.title": "바다 낚시 · 카피텐",
	"quest.2190A0BF4F37A17C.quest_desc": [
		"카피텐 한 마리를 제출하세요. 아래 다섯 어종 가운데 서로 다른 두 종류를 제출하면 바다 낚시 과제가 완료됩니다."
	],
	"quest.2CD8B3C564760599.title": "바다 낚시",
	"quest.2CD8B3C564760599.quest_desc": [
		"대서양 어종 다섯 가지 가운데 서로 다른 두 종류를 제출하면 열립니다. 모든 어종을 모을 필요는 없습니다.",
		"온대 바다·해변에서는 대서양 넙치·붉바리·참치가, 차가운 바다에서는 대서양 대구가, 건조한 지역 물가에서는 카피텐이 잡힙니다.",
		"보상으로 넵튜늄 잉곳 한 개를 받습니다. 워프스톤 두 개나 귀환 두루마리 여섯 장 같은 넵튜늄 전용 레시피에 쓸 수 있습니다.",
		"직접 체크하세요."
	],
	"quest.3E26AB2C09397E73.title": "넵튜늄",
	"quest.3E26AB2C09397E73.quest_desc": [
		"넵튜늄 잉곳 한 개를 보유하면 완료됩니다. 제출하지 않습니다.",
		"바다 낚시 보상으로 받은 잉곳으로 바로 완료할 수 있습니다. 선택 과제이며 장을 마치는 데 필요하지 않습니다.",
		"넵튜늄 레시피는 기존 재료보다 효율이 좋습니다: 워프스톤 2개, 귀환 두루마리 6장, 정수 필터 2개, 잉곳 한 개로 다이아 상자 등. JEI에서 확인하세요.",
		"추가 넵튜늄은 매우 드문 낚시 보물 상자(넵튠의 보물)에서 얻습니다."
	],
	"quest.544D8599AFBD288A.title": "넵튜늄 도구",
	"quest.544D8599AFBD288A.quest_desc": [
		"넵튜늄 도구 한 개를 보유하면 완료됩니다. 선택 과제이며 장을 마치는 데 필요하지 않습니다."
	],
	"quest.33BCBF88C712C05D.title": "넵튜늄 갑옷",
	"quest.33BCBF88C712C05D.quest_desc": [
		"넵튜늄 갑옷 한 부위를 보유하면 완료됩니다. 선택 과제이며 장을 마치는 데 필요하지 않습니다."
	],
	"quest.30AFCB65EDC66F27.title": "워프스톤",
	"quest.30AFCB65EDC66F27.quest_desc": [
		"워프스톤은 충전해 사용하는 이동 수단입니다. 기본 재료는 자수정 4·엔더 진주 4·금괴 1이며, 장미석영·넵튜늄 레시피는 JEI에서 확인하세요."
	],
	"quest.4FCC76B40788FA92.title": "워프 두루마리",
	"quest.4FCC76B40788FA92.quest_desc": [
		"워프 두루마리를 사용하면 등록한 거점 사이를 이동합니다."
	],
	"quest.2060E3828F8DE61D.title": "귀속 두루마리",
	"quest.2060E3828F8DE61D.quest_desc": [
		"귀속 두루마리로 현재 위치를 거점으로 지정하세요."
	],
	"quest.774FBFACEB9C9A37.title": "설원 탐험",
	"quest.774FBFACEB9C9A37.quest_desc": [
		"눈 덮인 타이가에 들어가면 완료됩니다. 온도계와 온열 팩을 챙기세요."
	],
	"quest.224BFEF1BD7E16D1.title": "한대 기후 상점",
	"quest.224BFEF1BD7E16D1.quest_desc": [
		"눈 덮인 지역에서 공급소 상점을 찾아 여세요. 지붕에 눈이 쌓인 가판대가 단서입니다.",
		"가죽과 양모는 식량 상점에서, 모닥불과 횃불은 무기 상점에서, 석탄은 광물 상점에서 더 비쌉니다. 숯과 얼음은 상대적으로 저렴합니다. 가격을 확인하고 직접 체크하세요. 선택 과제입니다."
	],
	"quest.0362720F2EF97E49.title": "악지 탐험",
	"quest.0362720F2EF97E49.quest_desc": [
		"악지에 들어가면 완료됩니다. 더위와 갈증이 겹치니 물과 온도계를 챙기세요."
	],
	"quest.62C9CE8381E0C4BD.title": "건조 기후 상점",
	"quest.62C9CE8381E0C4BD.quest_desc": [
		"건조 지역의 공급소 상점을 찾아 여세요. 사암 난간과 낮은 지붕이 단서입니다.",
		"물과 얼음은 물약 상점에서, 선인장은 식량 상점에서 상대적으로 저렴합니다. 증류수는 직접 만드는 편이 낫습니다. 가격을 확인하고 직접 체크하세요. 선택 과제입니다."
	],
	"quest.59FADBAAF7722C0B.title": "위험한 밤",
	"quest.59FADBAAF7722C0B.quest_desc": [
		"좀비 스무 마리를 처치하세요. 첫 좀비 처치로 모험 탭의 사냥 과제도 진행됩니다. 다른 몬스터는 처치 수에 포함되지 않습니다."
	],
	"quest.581C5DDF3449E189.title": "낚시 심화 · 조류",
	"quest.581C5DDF3449E189.quest_desc": [
		"조류를 제출하세요. 조류·거머리·유목·특수 훅 가운데 서로 다른 두 종류를 제출하면 낚시 심화 과제가 열립니다."
	],
	"quest.75289DBA1E4C1F71.title": "낚시 심화 · 거머리",
	"quest.75289DBA1E4C1F71.quest_desc": [
		"거머리를 제출하세요. 조류·거머리·유목·특수 훅 가운데 서로 다른 두 종류를 제출하면 낚시 심화 과제가 열립니다."
	],
	"quest.5D312C062D9ABB97.title": "낚시 심화 · 유목",
	"quest.5D312C062D9ABB97.quest_desc": [
		"유목을 제출하세요. 조류·거머리·유목·특수 훅 가운데 서로 다른 두 종류를 제출하면 낚시 심화 과제가 열립니다."
	],
	"quest.48F4D820DE113892.title": "낚시 심화 · 특수 훅",
	"quest.48F4D820DE113892.quest_desc": [
		"철 훅을 제외한 특수 훅을 한 번 얻으면 자동으로 완료됩니다. 훅은 제출하거나 소모하지 않습니다.",
		"조류·거머리·유목·특수 훅 가운데 서로 다른 두 가지를 마치면 낚시 심화 과제가 열립니다."
	],
	"quest.6FC639F125DA3D9E.title": "낚시 심화",
	"quest.6FC639F125DA3D9E.quest_desc": [
		"조류·거머리·유목·특수 훅 가운데 서로 다른 두 종류를 제출하면 열립니다. 다른 낚시 부산물은 인정되지 않습니다.",
		"직접 체크하세요."
	],
	"quest.49CA4687595DF2D8.title": "메디킷",
	"quest.49CA4687595DF2D8.quest_desc": [
		"체력을 크게 회복합니다. 외상 키트 2개, 금괴 4개, 황금 사과 1개로 만듭니다."
	],
	"quest.7F1562D4E3A27D9B.title": "진료소 키트",
	"quest.7F1562D4E3A27D9B.quest_desc": [
		"체력과 상태를 함께 치료합니다. 메디킷 1개, 야전 구급 키트 2개, 금괴 4개로 만듭니다.",
		"야전 구급 키트는 해독제·화상 연고·온열 팩·자극제·안약 하나씩과 상자로 만듭니다. 화상 연고에는 슬라임볼(또는 마그마 크림), 안약에는 아무 열매나 쓸 수 있습니다."
	],
	"quest.49D80AA1C5E8BB6B.title": "심층 탐험 마무리",
	"quest.49D80AA1C5E8BB6B.quest_desc": [
		"IV장을 마칩니다. 체크하세요."
	],
	"quest.640DA4CEB6AE2DFF.title": "전력 저장 장치",
	"quest.640DA4CEB6AE2DFF.quest_desc": [
		"기본 배터리는 강철·일렉트럼과 플라스틱 판이 필요합니다. 플라스틱은 나프타 정제나 생체 고분자 가공으로 마련하세요.",
		"정유·원심분리 공정을 익힌 뒤 배터리를 만들어 전력 생산과 저장을 확장하세요. IV장 이후의 선택 과제입니다."
	],
	"quest.62ACC082B71D8EFC.title": "구리 상자 업그레이드",
	"quest.62ACC082B71D8EFC.quest_desc": [
		"Iron Chests 모드의 기본 상자입니다. V장은 앞 장을 마치지 않아도 시작할 수 있습니다."
	],
	"quest.305D29E406DD390E.title": "상자 업그레이드",
	"quest.305D29E406DD390E.quest_desc": [
		"상자 업그레이드로 보관 용량을 단계별로 늘려 보세요."
	],
	"quest.70335B391DBA2734.title": "철 상자",
	"quest.70335B391DBA2734.quest_desc": [
		"철 상자는 구리 상자보다 더 많은 아이템을 보관합니다."
	],
	"quest.79F0AE9686190E9D.title": "금 상자",
	"quest.79F0AE9686190E9D.quest_desc": [
		"금 상자를 보유하세요. 다이아몬드 상자는 이 과제의 조건이 아닙니다."
	],
	"quest.3CD49C8B1B5EA3A8.title": "렌치",
	"quest.3CD49C8B1B5EA3A8.quest_desc": [
		"렌치로 파이프의 연결 방향을 조정하세요."
	],
	"quest.2B304446BC54A00C.title": "아이템 파이프",
	"quest.2B304446BC54A00C.quest_desc": [
		"아이템 파이프 여덟 개를 보유하세요. 파이프 연결은 뒤의 시설 과제에서 확인합니다."
	],
	"quest.405D80A08437B9A2.title": "유체 파이프",
	"quest.405D80A08437B9A2.quest_desc": [
		"유체 파이프로 물을 탱크나 기계에 옮기세요."
	],
	"quest.6E888C55ADD03BA9.title": "속도·필터 업그레이드",
	"quest.6E888C55ADD03BA9.quest_desc": [
		"관을 더 빠르게 쓰는 선택 장비입니다.",
		"장 마무리에는 필요 없습니다. 고급·궁극 업그레이드는 목표로 두지 않습니다."
	],
	"quest.2739523D880D76B1.title": "구리 탱크",
	"quest.2739523D880D76B1.quest_desc": [
		"물을 많이 담아 두는 구리 탱크입니다."
	],
	"quest.30534F49CB803F11.title": "철 탱크",
	"quest.30534F49CB803F11.quest_desc": [
		"철 탱크는 구리 탱크보다 더 많은 물을 저장합니다."
	],
	"quest.4479935B138C17F3.title": "저장조",
	"quest.4479935B138C17F3.quest_desc": [
		"저장조는 중·후반에 대량의 물을 보관하는 시설입니다."
	],
	"quest.6DA2A9B3E5CFC27F.title": "증류 라인",
	"quest.6DA2A9B3E5CFC27F.quest_desc": [
		"증류수 병 16개를 보유하면 완료됩니다. 제출하지 않습니다.",
		"물 저장조에서 등급 물을 유체 파이프로 증류기에 공급하고, 증류 결과인 물병과 양동이는 아이템 출력구에서 호퍼나 아이템 파이프로 회수하세요. 손으로 모아도 되지만 라인을 만들면 훨씬 빠릅니다."
	],
	"quest.3C6D7E17DEAF6CED.title": "정수 라인",
	"quest.3C6D7E17DEAF6CED.quest_desc": [
		"민물 병 16개를 보유하면 완료됩니다. 제출하지 않습니다.",
		"오염된 물 양동이를 유체 파이프로 정수 필터에 넣고, 빈 병과 필터 카트리지를 넣으세요. 정수된 물병은 아이템 출력구에서 회수하며 카트리지는 소모품입니다."
	],
	"quest.3557C64F80EC8314.title": "급수 시설",
	"quest.3557C64F80EC8314.quest_desc": [
		"증류수 양동이 4개를 보유하면 완료됩니다. 제출하지 않습니다.",
		"저장조에 증류수를 모아 두고 필요할 때 양동이나 물병으로 꺼내 쓰세요. 꾸준한 식수 공급을 위한 기반 시설입니다."
	],
	"quest.512AAE6A5E05FF27.title": "소금 공정",
	"quest.512AAE6A5E05FF27.quest_desc": [
		"소금 32개를 보유하면 완료됩니다. 제출하지 않습니다.",
		"바닷물을 증류기에 넣으면 증류수와 함께 소금이 나옵니다. 바닷물 → 증류기 → 소금 회수 라인을 만들어 보세요."
	],
	"quest.4B21F5A24114FD21.title": "부엌 연결",
	"quest.4B21F5A24114FD21.quest_desc": [
		"상자와 파이프를 연결해 부엌에 필요한 재료를 공급하세요.",
		"직접 체크하세요."
	],
	"quest.338F53CBF816ADAD.title": "수확물 모으기",
	"quest.338F53CBF816ADAD.quest_desc": [
		"수확물이 상자에 자동으로 모이도록 연결하세요.",
		"직접 체크하세요."
	],
	"quest.0842462F9A62C823.title": "백팩 확장",
	"quest.0842462F9A62C823.quest_desc": [
		"철 백팩을 보유하면 완료됩니다. 구리 백팩을 업그레이드하거나 직접 제작하세요.",
		"수납 공간 확장 업그레이드도 함께 써 보세요. 자석과 자동 줍기 업그레이드는 사용하지 않습니다."
	],
	"quest.20C6A855D971E0C7.title": "자동화 장 마무리",
	"quest.20C6A855D971E0C7.quest_desc": [
		"V장·튜토리얼을 마칩니다. 인장과 도감 마무리 단계로 가세요. 체크하세요."
	],
	"quest.3059BE8DE14E8D4D.title": "전력 공방 연결",
	"quest.3059BE8DE14E8D4D.quest_desc": [
		"초중반에 준비한 Oritech 발전기·전력 관·분쇄기를 급수·부엌·수확물 보관 시설과 연결해 보세요.",
		"전동 기계와 수송 시설이 실제로 작동하고 필요한 재료가 공방에 모이면 체크하세요. 배치와 작동 상태는 자동 감지되지 않습니다. 선택 과제입니다.",
		"기본 자동화 장을 끝낸 뒤 더 큰 공방을 확장하는 후반 프로젝트입니다. 핵분열·입자가속기·대규모 채석은 필수 목표로 두지 않습니다."
	],
	"quest.3C1301788B81ED97.title": "심부 자원 탐지기",
	"quest.3C1301788B81ED97.quest_desc": [
		"자원 노드 공명기는 전력을 충전해 주변에 로드된 청크의 심부 자원 노드를 찾습니다.",
		"지표의 광석 바위는 베드락 아래 자원 노드의 위치를 알려 주는 표식입니다. 탐지 범위와 충전량을 확인하며 찾으세요. 선택 후반 과제입니다."
	],
	"quest.46D063E9E931F815.title": "베드락 채굴기",
	"quest.46D063E9E931F815.quest_desc": [
		"베드락 채굴기는 자원 노드에서 원료를 지속적으로 채취하는 고급 설비입니다.",
		"희귀 금속과 고급 부품이 필요한 선택 후반 목표입니다. 설치와 가동에는 충분한 전력망을 준비하세요."
	],
	"quest.437A5C18CAB5F403.title": "퀘스트북 펼치기",
	"quest.437A5C18CAB5F403.quest_desc": [
		"장 구성, 선행 조건, 보상 받는 법을 익히세요.",
		"읽었으면 체크하세요."
	],
	"quest.125C5DFA15AA03D6.title": "화면 살펴보기",
	"quest.125C5DFA15AA03D6.quest_desc": [
		"배고픔(AppleSkin), 갈증·체온 아이콘, 우상단 미니맵, 그 아래 계절·시계·기온(달력/시계/온도계가 있을 때)을 확인하세요. 상태 효과 아이콘은 좌상단입니다.",
		"아이템·블록 이름이 영어로 보이면 설정 → 언어를 한국어로 바꾸고, 설정 → 리소스 팩에서 rs-korean을 맨 위로 활성화하세요.",
		"HUD를 확인했는지는 자동으로 기록되지 않습니다. 확인한 뒤 직접 체크하세요."
	],
	"quest.79A1ABC2F7CEA7F2.title": "첫 나무",
	"quest.79A1ABC2F7CEA7F2.quest_desc": [
		"스폰 지점의 나무면 종류는 상관없습니다. 통나무 네 개를 모으면 자동으로 완료됩니다.",
		"Treeliable 모드에서는 나무가 시간이 지나며 통째로 쓰러집니다. 큰 나무일수록 도끼 내구도와 허기를 더 많이 소모합니다."
	],
	"quest.254C79229524A098.title": "작업대",
	"quest.254C79229524A098.quest_desc": [
		"기본 제작에 쓰는 작업대입니다. 작업대를 얻으면 이야기 탭의 관련 과제가 열립니다."
	],
	"quest.6F08E3B262E1DB7A.title": "돌 도구",
	"quest.6F08E3B262E1DB7A.quest_desc": [
		"돌 곡괭이와 돌 도끼를 만드세요. 돌 곡괭이를 얻으면 이야기 탭의 조약돌 과제가 진행됩니다."
	],
	"quest.3D9DD606BE543E1A.title": "첫 밤",
	"quest.3D9DD606BE543E1A.quest_desc": [
		"색깔에 관계없이 침대에서 한 번 자면 완료됩니다. 모험 탭의 잠자기 과제도 함께 진행됩니다.",
		"모험 탭은 몹을 처치하거나 사망한 뒤 열립니다. 과제가 보이지 않으면 조건을 달성한 뒤 다시 확인하세요.",
		"침대에서 밤을 보내고 리스폰 지점도 설정해 두세요."
	],
	"quest.2B4607CF88F06737.title": "청크 점유하기",
	"quest.2B4607CF88F06737.quest_desc": [
		"FTB Chunks 맵을 열고 청크 하나를 점유해 보세요.",
		"유적이나 던전처럼 함께 탐험할 장소는 점유하지 않는 편이 좋습니다.",
		"직접 체크하세요."
	],
	"quest.73CAEB3C9E393406.title": "파티",
	"quest.73CAEB3C9E393406.quest_desc": [
		"FTB Teams 파티나 팀 화면을 열어 보세요. 퀘스트 제출과 물 마시기는 각자 진행해야 합니다.",
		"직접 체크하세요."
	],
	"quest.35C2C67A589F4DA4.title": "지도와 웨이포인트",
	"quest.35C2C67A589F4DA4.quest_desc": [
		"FTB Chunks 미니맵이나 월드맵에 집·물·광산처럼 다시 올 곳을 웨이포인트로 하나 표시해 보세요.",
		"바닐라 빈 지도는 나침반(철·레드스톤)이 필요해 이 시점에서는 요구하지 않습니다. 지도 제작은 철을 구한 뒤에 해도 됩니다.",
		"직접 체크하세요."
	],
	"quest.4B6E7A3FF83A5AE2.title": "레시피 찾기",
	"quest.4B6E7A3FF83A5AE2.quest_desc": [
		"JEI에서 아이템의 제작법과 사용처를 찾아보고, Jade 오버레이로 블록 정보를 확인하세요.",
		"화면을 열었는지는 자동으로 감지되지 않습니다. 확인한 뒤 직접 체크하세요."
	],
	"quest.1AF3970D831B7508.title": "짐 정리",
	"quest.1AF3970D831B7508.quest_desc": [
		"상자를 만들고 Mouse Tweaks와 TrashSlot으로 보관함과 인벤토리를 정리해 보세요."
	],
	"quest.229DD67761C873FC.title": "도전과제 화면",
	"quest.229DD67761C873FC.quest_desc": [
		"Better Advancements로 도전과제 화면을 열어 보세요. 이 모드는 화면을 보기 좋게 바꿉니다.",
		"퀘스트와 도감을 진행하면서 관련 도전과제도 함께 달성합니다.",
		"화면을 열었는지는 자동으로 감지되지 않습니다. 확인한 뒤 직접 체크하세요."
	],
	"quest.6D8FFC6BC825D480.title": "물 마셔 보기",
	"quest.6D8FFC6BC825D480.quest_desc": [
		"갈증이 생깁니다. 월드의 물에는 등급이 있습니다. 물의 종류를 확인하지 않고 마시지 마세요.",
		"자세한 해결은 I장에서 이어집니다.",
		"직접 체크하세요."
	],
	"quest.4D61A33A8BF76CE0.title": "말하기 (선택)",
	"quest.4D61A33A8BF76CE0.quest_desc": [
		"Simple Voice Chat으로 말해 보세요.",
		"직접 체크하세요."
	],
	"quest.7902CFAF0F6B04B0.title": "다음 여정을 향해",
	"quest.7902CFAF0F6B04B0.quest_desc": [
		"0장을 마칩니다. 다른 장의 첫 퀘스트는 이미 열려 있습니다. 체크하세요."
	]
}
