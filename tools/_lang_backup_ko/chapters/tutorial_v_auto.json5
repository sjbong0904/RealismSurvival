{
	"quest.5918A63631C68082.title": "자동화 입문",
	"quest.5918A63631C68082.quest_desc": [
		"더 큰 상자, 물건과 물을 옮기는 관, 그리고 증류를 돕는 장치를 익힙니다.",
		"복잡한 공장까지는 아직 아니어도, 손이 덜 가는 흐름을 만들어 보세요."
	],
	"quest.045E8A8069666675.title": "구리 상자",
	"quest.045E8A8069666675.quest_desc": [
		"나무 상자보다 넉넉한 저장이 필요합니다."
	],
	"quest.40A54288103B6809.title": "철 상자",
	"quest.40A54288103B6809.quest_desc": [
		"저장을 한 단계 더 키워 보세요.",
		"업그레이드 도구로 제자리에서 올릴 수도 있습니다."
	],
	"quest.118797AEEA7B67C3.title": "금 상자",
	"quest.118797AEEA7B67C3.quest_desc": [
		"더 큰 창고를 경험해 보세요."
	],
	"quest.3300413EEE71D5E9.title": "호퍼로 돕기",
	"quest.3300413EEE71D5E9.quest_desc": [
		"증류기에 재료와 연료가 저절로 들어가게 해 보세요.",
		"한 번 돌아가면 체크하면 됩니다."
	],
	"quest.5475CAE5A3ECC741.title": "물건 관",
	"quest.5475CAE5A3ECC741.quest_desc": [
		"물건을 옮기는 관을 깔아 보세요.",
		"렌치로 어느 쪽이 들어오고 나가는지 맞출 수 있습니다."
	],
	"quest.62D97FCCC3595F13.title": "물 관",
	"quest.62D97FCCC3595F13.quest_desc": [
		"물을 옮기는 관입니다.",
		"흘러나온 물이 평범한 바닐라 물로 남지 않게 주의하세요."
	],
	"quest.7D5D6ECAD2D7F487.title": "물 탱크",
	"quest.7D5D6ECAD2D7F487.quest_desc": [
		"물을 모아 둘 큰 통을 세워 보세요."
	],
	"quest.57A4295F595D1726.title": "등에 멘 가방",
	"quest.57A4295F595D1726.quest_desc": [
		"원정용 가방이 있으면 손이 한결 편합니다.",
		"고급 기능은 나중에 천천히 붙여도 됩니다."
	],
	"quest.2F866DC3DDA096CB.title": "★ 자동화 왕관",
	"quest.2F866DC3DDA096CB.quest_desc": [
		"본편 퀘스트를 모두 완료해야 합니다."
	]
}
