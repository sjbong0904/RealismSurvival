{
	"quest.70F4FF0291395C40.title": "밖으로",
	"quest.70F4FF0291395C40.quest_desc": [
		"기지 밖으로 나가 볼 차례입니다.",
		"물과 식량, 횃불을 챙기고 길을 나서 보세요."
	],
	"quest.27E37908FECCD824.title": "원정 준비",
	"quest.27E37908FECCD824.quest_desc": [
		"멀리 나가기 전에 마실 물과 먹을 것, 불을 밝힐 것을 챙겼는지 확인하세요."
	],
	"quest.7D3087DE3E7C2A0E.title": "자연의 나침반",
	"quest.7D3087DE3E7C2A0E.quest_desc": [
		"원하는 땅을 찾아 주는 나침반입니다.",
		"낯선 풍경도 이걸로 찾아갈 수 있어요."
	],
	"quest.41D996CE1F0A237B.title": "낯선 땅",
	"quest.41D996CE1F0A237B.quest_desc": [
		"평소와 다른 풍경의 땅에 직접 가 보세요.",
		"체온과 물이 어떻게 느껴지는지 관찰해 보면 좋습니다."
	],
	"quest.1329D036709D8692.title": "마을을 찾다",
	"quest.1329D036709D8692.quest_desc": [
		"사람이 사는 마을에 발을 들여 보세요."
	],
	"quest.15F4D83A32772F08.title": "나만의 전리품",
	"quest.15F4D83A32772F08.quest_desc": [
		"특수 상자를 열면 각자 몫이 나옵니다.",
		"친구와 같이 가도 서로 빼앗기지 않아요."
	],
	"quest.05246543449129E0.title": "파티 맺기",
	"quest.05246543449129E0.quest_desc": [
		"함께할 동료가 있다면 파티를 만들어 보세요.",
		"혼자 플레이한다면 체크만 해도 됩니다."
	],
	"quest.6EDB634C3BABF365.title": "집 지키기",
	"quest.6EDB634C3BABF365.quest_desc": [
		"집 주변을 구역으로 정해 두면 안심입니다.",
		"강제 로드는 꼭 필요한 곳만, 너무 넓게 잡지 마세요."
	],
	"quest.17EA2E752F7C3820.title": "귀환의 돌",
	"quest.17EA2E752F7C3820.quest_desc": [
		"돌아갈 곳을 하나 정해 두면 원정이 한결 편해집니다.",
		"너무 많이 늘리기보다는, 거점 위주로 쓰는 걸 추천합니다."
	],
	"quest.006B7F7417BD375D.title": "마을 경비",
	"quest.006B7F7417BD375D.quest_desc": [
		"직업이 없는 주민에게 검을 주어 보초병으로 만드세요.",
		"생성 알이 아니라, 실제로 고용해야 완료됩니다."
	],
	"quest.05EF3D187B2394E8.title": "★ 탐험 왕관",
	"quest.05EF3D187B2394E8.quest_desc": [
		"본편 퀘스트를 모두 완료해야 합니다."
	]
}
