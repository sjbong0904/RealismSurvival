{
	"quest.06B5517AE79C8CB5.title": "이 세계의 규칙",
	"quest.06B5517AE79C8CB5.quest_desc": [
		"이 세계에서는 물이 모두 같지 않습니다.",
		"바닷물이나 오염된 물을 그대로 마시면 갈증이 해소되지 않습니다.",
		"먼저 안전한 물(증류수)을 만드는 방법을 익혀 봅시다.",
		"읽었다면 체크를 눌러 주세요."
	],
	"quest.31A54275F5864ADA.title": "물 등급을 한눈에 보자",
	"quest.31A54275F5864ADA.quest_desc": [
		"증류수는 안전을 보장합니다. 민물은 급할때 마시기는 충분하지만, 꾸준한 섭취는 좋지 않습니다.",
		"오염된 물과 바닷물은 안전하지 않습니다. 필터와 증류로 정화해야 합니다.",
		"월드의 열린 물은 바닐라 물이 아니라 등급 물입니다."
	],
	"quest.6CBB73CFA3A992F4.title": "체온에 대해",
	"quest.6CBB73CFA3A992F4.quest_desc": [
		"추위·더위는 HUD와 온도계로 확인할 수 있습니다.",
		"갑작스러운 바이옴 이동 전 장비와 물을 챙기는 것을 잊지 마세요."
	],
	"quest.64B0E8886E4D1DA7.title": "벌목에 대해",
	"quest.64B0E8886E4D1DA7.quest_desc": [
		"이 모드팩의 벌목은 Treeliable 모드가 담당합니다.",
		"벌목/쓰러뜨리기를 토글할 수 있습니다.",
	],
	"quest.268396713B9B58E9.title": "퀘스트 책에 대해",
	"quest.268396713B9B58E9.quest_desc": [
		"왼쪽 탭에 대한 설명입니다.",
		"튜토리얼: 기초적인 생존과 핵심 진행 루트입니다.",
		"생존 팁: 각종 팁을 모아놓은 부분입니다.",
		"번들: 여유가 된다면 모아서 완료하세요.",
		"도감: 수집과 엔딩. 여유가 생길 때 펼치세요."
	],
	"quest.39C2D77C8287209C.title": "파티와 청크 (OPC)",
	"quest.39C2D77C8287209C.quest_desc": [
		"멀티에서는 Open Parties and Claims로 파티·땅을 관리합니다.",
		"집은 구역으로 설정해도 되지만, 던전·유적 구역은 사유화하지 마세요.",
		"청크 로드는 플레이어당 최대 16청크입니다."
	],
	"quest.4A32BB1FED7C6883.title": "튜토리얼로",
	"quest.4A32BB1FED7C6883.quest_desc": [
		"왼쪽 챕터에서 「I 생존 기반」을 열어 본편을 시작하세요."
	]
}