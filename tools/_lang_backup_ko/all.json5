	],
	"quest.2A2D62034DD34556.title": "수확 세트",
	"quest.2A2D62034DD34556.quest_desc": [
		"밭에서 거둔 작물로 한 상을 채워 보세요."
	],
	"quest.05EAB233D01210CA.title": "요리 세트",
	"quest.05EAB233D01210CA.quest_desc": [
		"직접 끓이거나 지은 음식으로 한 끼를 내세요."
	],
	"quest.04A3296DBE2564C0.title": "낚시 음식",
	"quest.04A3296DBE2564C0.quest_desc": [
		"물에서 잡은 것을 요리해 보세요."
	],
	"quest.58ECFBB78EC7809D.title": "★ 음식 인장",
	"quest.58ECFBB78EC7809D.quest_desc": [
		"본편 퀘스트를 모두 완료해야 합니다."
	],
	"quest.434C1DB8F71E4BDA.title": "목축 방",
	"quest.434C1DB8F71E4BDA.quest_desc": [
		"가축과 반려, 벌꿀을 다루는 번들입니다.",
