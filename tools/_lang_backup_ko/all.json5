	"quest.1E5757B6122D7371.title": "프리즈마린 수정",
	"quest.66C7E6F80C13DFFC.title": "네더의 별",
	"quest.0003B7A7795F1321.title": "소금",
	"quest.076B0A78FC0A6F0D.title": "소금 블록",
	"quest.0E8F00F93013FFA9.title": "필터 카트리지",
	"quest.39ACA36A302954F3.title": "온도계",
	"quest.6631D26CFD1D2987.title": "등급 얼음",
	"quest.67F3F82D0FDBFA32.title": "달력",
	"quest.7382363CF911C5AF.title": "계절 센서",
	"quest.29D24C4D5D7364E9.title": "★ 광물 도감 완성",
	"quest.29D24C4D5D7364E9.quest_desc": [
		"도감의 모든 항목을 채워야 합니다."
	],
	"quest.7820B32464455F13.title": "완벽을 향하여",
	"quest.7820B32464455F13.quest_desc": [
		"다섯 인장과 도감을 모두 모으면 엔딩입니다.",
		"보스 한 마리로 건너뛰지 않습니다.",
		"시작하려면 체크하세요."
	],
	"quest.70B0BC9458D2FA9B.title": "다섯 인장",
	"quest.70B0BC9458D2FA9B.quest_desc": [
		"생존·음식·탐험·길들이기·산업 인장을 모두 모은 뒤 체크하세요."
	],
	"quest.4275DD0E78854D6B.title": "★ Realism Perfection",
	"quest.4275DD0E78854D6B.quest_desc": [
		"다섯 인장과 모든 도감을 채운 진짜 엔딩입니다.",
		"전투가 아니라 수집과 생존의 증명입니다."
	],
	"quest.3F85846D37445BBF.title": "물 등급 팁",
	"quest.3F85846D37445BBF.quest_desc": [
		"민물은 급할 때 쓰고, 평소에는 안전한 물을 마시세요.",
		"거른 뒤 증류하면 더 안심입니다.",
		"바닷물로는 요리나 농사를 하지 마세요.",
		"읽었다면 체크하세요."
	],
	"quest.37509039FAAB14F5.title": "체온 팁",
	"quest.37509039FAAB14F5.quest_desc": [
		"옷과 땅, 시간이 체온에 영향을 줍니다.",
		"위험할 때는 멈추고 불을 피우거나 그늘로 피하세요.",
		"온도계와 달력을 벨트에 두면 편합니다.",
		"읽었다면 체크하세요."
	],
	"quest.2902C3D05D919C2E.title": "계절과 농사",
	"quest.2902C3D05D919C2E.quest_desc": [
		"작물과 눈·얼음은 계절을 따릅니다.",
		"달력으로 지금 계절을 확인하세요.",
		"온실이나 실내 농장은 중반 이후에 노려 보세요.",
		"읽었다면 체크하세요."
	],
	"quest.1F8DBCE098A4896C.title": "지도와 구역",
	"quest.1F8DBCE098A4896C.quest_desc": [
		"지도로 길을 찾고, 집 주변은 구역으로 지키세요.",
		"강제 로드는 플레이어당 열여섯 칸까지입니다.",
		"유적지는 사유화하지 않는 편이 좋아요.",
		"읽었다면 체크하세요."
	],
	"quest.035C587871A793F6.title": "음식 다양성",
	"quest.035C587871A793F6.quest_desc": [
		"같은 음식만 먹으면 회복이 줄어듭니다.",
		"요리를 넓혀 메뉴를 다양하게 가져 보세요.",
		"여유될 때 읽으면 됩니다."
	],
	"quest.5862C8257263F42E.title": "낚시 팁",
	"quest.5862C8257263F42E.quest_desc": [
		"좋은 낚싯대와 미끼가 있으면 더 다양한 물고기를 만날 수 있습니다.",
		"양동이에 담은 물고기는 등급이 맞는 물에 풀어 주세요.",
		"여유될 때 읽으면 됩니다."
	],
	"quest.5322A9DE79F65467.title": "관과 탱크",
	"quest.5322A9DE79F65467.quest_desc": [
		"렌치로 관의 방향과 필터를 맞춥니다.",
		"물 흐름에 평범한 바닐라 물이 남지 않게 주의하세요.",
		"여유될 때 읽으면 됩니다."
	],
	"quest.7E19364AD7DD8155.title": "펫 관리",
	"quest.7E19364AD7DD8155.quest_desc": [
		"침대를 두면 반려 동물을 부를 수 있습니다.",
		"귀환 거점과 함께 쓰면 원정에도 데려가기 쉽습니다.",
		"여유될 때 읽으면 됩니다."
	],
	"quest.3CC65064CBC0DB6E.title": "기초 생존 안내",
	"quest.3CC65064CBC0DB6E.quest_desc": [
		"목표는 안전한 물(증류수)입니다.",
		"월드 가마솥에 이미 증류수가 있을 수도 있고,",
		"직접 증류기를 만들어 증류 할 수도 있습니다."
	],
	"quest.28F2B54355866F1C.title": "쉴 곳",
	"quest.28F2B54355866F1C.quest_desc": [
		"모닥불을 피워 온기를 확보하세요."
	],
	"quest.514C8819849AC030.title": "그릇이 필요해",
	"quest.514C8819849AC030.quest_desc": [
		"유리병을 준비해 물을 담을 준비를 하세요."
	],
	"quest.17294BD0E01E38E9.title": "연료를 찾자",
	"quest.17294BD0E01E38E9.quest_desc": [
		"증류에는 연료가 필요합니다. 석탄을 모아 두세요."
	],
	"quest.3747972C50749D27.title": "네 종류의 물",
	"quest.3747972C50749D27.quest_desc": [
		"증류수 / 민물 / 오염된 물 / 바닷물.",
		"병 아이템 이름과 색으로 등급을 구분하세요."
	],
	"quest.2C57F38B449DB93B.title": "갈증",
	"quest.2C57F38B449DB93B.quest_desc": [
		"허기보다 갈증이 당신을 위협할 수 있습니다.",
		"민물로 갈증이 어떻게 움직이는지 한 번 느껴 보세요."
	],
	"quest.586557BB2D387F10.title": "측정은 중요해",
	"quest.586557BB2D387F10.quest_desc": [
		"온도계를 만들어 체온을 확인할 준비를 하세요.",
		"보상으로 달력도 받을 수 있습니다."
	],
	"quest.0124AB711749BFDD.title": "정화의 길",
	"quest.0124AB711749BFDD.quest_desc": [
		"증류기는 안전한 물을 확보하기 위한 중요한 수단이 됩니다."
	],
	"quest.13B88BDCA02EECB9.title": "★ 증류수 왕관",
	"quest.13B88BDCA02EECB9.quest_desc": [
		"본편 퀘스트를 모두 완료해야 합니다.",
		"안전한 물도 하나 준비해 두세요."
	],
	"quest.3B24184EA956C3F8.title": "농사의 시작",
	"quest.3B24184EA956C3F8.quest_desc": [
		"기초적인 농사의 시작입니다."
	],
	"quest.00E55FC90354D6F4.title": "원목",
	"quest.00E55FC90354D6F4.quest_desc": [
		"벌목의 시작입니다. 참나무 원목을 모아 보세요."
	],
	"quest.604960C7CDE848E1.title": "조약돌",
	"quest.604960C7CDE848E1.quest_desc": [
		"광산을 만들 준비가 되었나요?"
	],
	"quest.4F4865E3A78FB64A.title": "불을 밝히자",
	"quest.4F4865E3A78FB64A.quest_desc": [
		"주변이 밝아졌네요!"
	],
	"quest.4D34148D1558077E.title": "세월을 낚다",
	"quest.4D34148D1558077E.quest_desc": [
		"잘 낚은 생선 하나."
	],
	"quest.50C228E15E6D38EB.title": "지도를 펼치다",
	"quest.50C228E15E6D38EB.quest_desc": [
		"나침반을 만들어 방향을 잡아 보세요."
	],
	"quest.0B9FEDBD40E40B93.title": "하룻밤",
	"quest.0B9FEDBD40E40B93.quest_desc": [
		"침대에서 한 번 취침하세요."
	],
	"quest.10F1077399DEFD46.title": "체온 주의보",
	"quest.10F1077399DEFD46.quest_desc": [
		"사막·눈 바이옴은 체온이 빠르게 변합니다. 물을 넉넉히 챙기세요."
	],
	"quest.705F054EC036BF3D.title": "밭으로",
	"quest.705F054EC036BF3D.quest_desc": [
		"안전한 물을 확보했다면, 이제 밭과 부엌으로 넘어갑니다.",
		"계절이 작물 성장에 영향을 줍니다. 달력을 옆에 두는 편이 좋아요."
	],
	"quest.44E48E20E9552F2A.title": "경작",
	"quest.44E48E20E9552F2A.quest_desc": [
		"땅을 갈아 밭을 만들 준비가 되었나요?"
	],
	"quest.09ED627D76E33E14.title": "계절 달력",
	"quest.09ED627D76E33E14.quest_desc": [
		"달력을 들면 지금이 어떤 계절인지 화면에 나타납니다.",
		"봄과 가을은 밀처럼 서늘한 작물에 좋고,",
		"여름은 따뜻한 작물에 유리합니다.",
		"겨울에는 대부분 작물이 잘 자라지 않으니, 실내나 비료를 생각해 보세요."
	],
	"quest.35B0BFB713484039.title": "밀 수확",
	"quest.35B0BFB713484039.quest_desc": [
		"밀은 서늘한 작물입니다.",
		"맞는 계절에 심으면 잘 자라고, 겨울에는 느려집니다."
	],
	"quest.350AD42259E84A50.title": "밭에 물을",
	"quest.350AD42259E84A50.quest_desc": [
		"물의 종류가 밭에도 영향을 줍니다.",
		"가능하면 안전한 물로 흙을 적시세요. 바닷물은 쓰지 마세요."
	],
	"quest.732F64EBBE9027DC.title": "도마",
	"quest.732F64EBBE9027DC.quest_desc": [
		"본격적인 요리의 시작입니다. 재료를 썰 자리가 필요해요."
	],
	"quest.7BD2F5A8FDB408AE.title": "냄비",
	"quest.7BD2F5A8FDB408AE.quest_desc": [
		"국과 스튜를 끓이려면 냄비가 중심이 됩니다."
	],
	"quest.2FB463350074B333.title": "스토브",
	"quest.2FB463350074B333.quest_desc": [
		"부엌에 불을 들여 본격적인 주방을 만드세요."
	],
	"quest.05CA20DAF3D6CE4E.title": "프라이팬",
	"quest.05CA20DAF3D6CE4E.quest_desc": [
		"볶고 굽는 요리가 열립니다."
	],
	"quest.6FD17506059DC777.title": "한 끼 요리",
	"quest.6FD17506059DC777.quest_desc": [
		"직접 만든 음식으로 한 끼를 해결해 보세요.",
		"다양한 음식을 먹을수록 몸이 더 잘 회복됩니다."
	],
	"quest.3681862A7CB558CA.title": "음식 도감",
	"quest.3681862A7CB558CA.quest_desc": [
		"먹은 음식을 기록하는 책이 있습니다.",
		"메뉴를 넓힐수록 하트가 늘어나는 것을 확인해 보세요."
	],
	"quest.6F8A7BA9B0141436.title": "식단 다양화",
	"quest.6F8A7BA9B0141436.quest_desc": [
		"같은 것만 먹지 말고, 여러 가지를 맛보세요."
	],
	"quest.1438B299CC008F74.title": "낚싯대",
	"quest.1438B299CC008F74.quest_desc": [
		"물가에서 시간을 보내 볼까요?"
	],
	"quest.44A4568C1A096D4A.title": "미끼 농장",
	"quest.44A4568C1A096D4A.quest_desc": [
		"미끼가 있으면 낚시가 한결 수월해집니다."
	],
	"quest.3AA49369AA0A5EFF.title": "낚시 도구함",
	"quest.3AA49369AA0A5EFF.quest_desc": [
		"바늘과 줄을 정리해 두면 원정에도 편합니다."
	],
	"quest.5F2E1CB96109C2E0.title": "큰 물고기",
	"quest.5F2E1CB96109C2E0.quest_desc": [
		"조금 특별한 물고기를 한 마리 올려 보세요."
	],
	"quest.04BC08B784669EB8.title": "★ 부엌 왕관",
	"quest.04BC08B784669EB8.quest_desc": [
		"본편 퀘스트를 모두 완료해야 합니다."
	],
	"quest.70F4FF0291395C40.title": "밖으로",
	"quest.70F4FF0291395C40.quest_desc": [
		"기지 밖으로 나가 볼 차례입니다.",
		"물과 식량, 횃불을 챙기고 길을 나서 보세요."
	],
	"quest.27E37908FECCD824.title": "원정 준비",
	"quest.27E37908FECCD824.quest_desc": [
		"멀리 나가기 전에 마실 물과 먹을 것, 불을 밝힐 것을 챙겼는지 확인하세요."
	],
	"quest.7D3087DE3E7C2A0E.title": "자연의 나침반",
	"quest.7D3087DE3E7C2A0E.quest_desc": [
		"원하는 땅을 찾아 주는 나침반입니다.",
		"낯선 풍경도 이걸로 찾아갈 수 있어요."
	],
	"quest.41D996CE1F0A237B.title": "낯선 땅",
	"quest.41D996CE1F0A237B.quest_desc": [
		"평소와 다른 풍경의 땅에 직접 가 보세요.",
		"체온과 물이 어떻게 느껴지는지 관찰해 보면 좋습니다."
	],
	"quest.1329D036709D8692.title": "마을을 찾다",
	"quest.1329D036709D8692.quest_desc": [
		"사람이 사는 마을에 발을 들여 보세요."
	],
	"quest.15F4D83A32772F08.title": "나만의 전리품",
	"quest.15F4D83A32772F08.quest_desc": [
		"특수 상자를 열면 각자 몫이 나옵니다.",
		"친구와 같이 가도 서로 빼앗기지 않아요."
	],
	"quest.05246543449129E0.title": "파티 맺기",
	"quest.05246543449129E0.quest_desc": [
		"함께할 동료가 있다면 파티를 만들어 보세요.",
		"혼자 플레이한다면 체크만 해도 됩니다."
	],
	"quest.6EDB634C3BABF365.title": "집 지키기",
	"quest.6EDB634C3BABF365.quest_desc": [
		"집 주변을 구역으로 정해 두면 안심입니다.",
		"강제 로드는 꼭 필요한 곳만, 너무 넓게 잡지 마세요."
	],
	"quest.17EA2E752F7C3820.title": "귀환의 돌",
	"quest.17EA2E752F7C3820.quest_desc": [
		"돌아갈 곳을 하나 정해 두면 원정이 한결 편해집니다.",
		"너무 많이 늘리기보다는, 거점 위주로 쓰는 걸 추천합니다."
	],
	"quest.006B7F7417BD375D.title": "마을 경비",
	"quest.006B7F7417BD375D.quest_desc": [
		"직업이 없는 주민에게 검을 주면 경비가 될 수 있습니다."
	],
	"quest.05EF3D187B2394E8.title": "★ 탐험 왕관",
	"quest.05EF3D187B2394E8.quest_desc": [
		"본편 퀘스트를 모두 완료해야 합니다."
	],
	"quest.43FE69D8B766A61B.title": "더 깊게",
	"quest.43FE69D8B766A61B.quest_desc": [
		"유적과 네더, 희귀한 유물을 건드릴 차례입니다.",
		"준비 없이 들어가면 금방 위험해질 수 있어요."
	],
	"quest.1BF833C8C4B99985.title": "위험한 거점",
	"quest.1BF833C8C4B99985.quest_desc": [
		"약탈자들이 버티고 있는 곳에 들어가 보세요.",
		"장비와 물을 충분히 챙긴 뒤 도전하세요."
	],
	"quest.03E38AECE3255EEF.title": "네더 문",
	"quest.03E38AECE3255EEF.quest_desc": [
		"다른 차원으로 넘어갑니다.",
		"체온과 물, 장비를 다시 한 번 점검하세요."
	],
	"quest.4BFEE186CF32750A.title": "네더 생존",
	"quest.4BFEE186CF32750A.quest_desc": [
		"황금 사과와 익힌 고기를 갖춘 뒤 탐험을 이어 가세요."
	],
	"quest.254D950325867CFC.title": "유물 하나",
	"quest.254D950325867CFC.quest_desc": [
		"유적에서 특이한 장비를 만나면 잘 챙기세요.",
		"나중에 유물 도감에서 하나씩 모을 수 있습니다."
	],
	"quest.5859C9D045D51BEC.title": "두 번째 귀환",
	"quest.5859C9D045D51BEC.quest_desc": [
		"멀리서도 거점으로 돌아올 수 있는 수단을 경험해 보세요.",
		"거점은 너무 많이 만들지 않는 편이 관리하기 쉽습니다."
	],
	"quest.333F506FB7385BA4.title": "반려의 자리",
	"quest.333F506FB7385BA4.quest_desc": [
		"길들인 동물을 부를 자리를 마련해 두세요."
	],
	"quest.4AD088EE606477B5.title": "★ 깊은 곳 왕관",
	"quest.4AD088EE606477B5.quest_desc": [
		"본편 퀘스트를 모두 완료해야 합니다."
	],
	"quest.5918A63631C68082.title": "자동화 입문",
	"quest.5918A63631C68082.quest_desc": [
		"더 큰 상자, 물건과 물을 옮기는 관, 그리고 증류를 돕는 장치를 익힙니다.",
		"복잡한 공장까지는 아직 아니어도, 손이 덜 가는 흐름을 만들어 보세요."
	],
	"quest.045E8A8069666675.title": "구리 상자",
	"quest.045E8A8069666675.quest_desc": [
		"나무 상자보다 넉넉한 저장이 필요합니다."
	],
	"quest.40A54288103B6809.title": "철 상자",
	"quest.40A54288103B6809.quest_desc": [
		"저장을 한 단계 더 키워 보세요.",
		"업그레이드 도구로 제자리에서 올릴 수도 있습니다."
	],
	"quest.118797AEEA7B67C3.title": "금 상자",
	"quest.118797AEEA7B67C3.quest_desc": [
		"더 큰 창고를 경험해 보세요."
	],
	"quest.3300413EEE71D5E9.title": "호퍼로 돕기",
	"quest.3300413EEE71D5E9.quest_desc": [
		"증류기에 재료와 연료가 저절로 들어가게 해 보세요.",
		"한 번 돌아가면 체크하면 됩니다."
	],
	"quest.5475CAE5A3ECC741.title": "물건 관",
	"quest.5475CAE5A3ECC741.quest_desc": [
		"물건을 옮기는 관을 깔아 보세요.",
		"렌치로 어느 쪽이 들어오고 나가는지 맞출 수 있습니다."
	],
	"quest.62D97FCCC3595F13.title": "물 관",
	"quest.62D97FCCC3595F13.quest_desc": [
		"물을 옮기는 관입니다.",
		"흘러나온 물이 평범한 바닐라 물로 남지 않게 주의하세요."
	],
	"quest.7D5D6ECAD2D7F487.title": "물 탱크",
	"quest.7D5D6ECAD2D7F487.quest_desc": [
		"물을 모아 둘 큰 통을 세워 보세요."
	],
	"quest.57A4295F595D1726.title": "등에 멘 가방",
	"quest.57A4295F595D1726.quest_desc": [
		"원정용 가방이 있으면 손이 한결 편합니다.",
		"고급 기능은 나중에 천천히 붙여도 됩니다."
	],
	"quest.2F866DC3DDA096CB.title": "★ 자동화 왕관",
	"quest.2F866DC3DDA096CB.quest_desc": [
		"본편 퀘스트를 모두 완료해야 합니다."
	],
	"quest.06B5517AE79C8CB5.title": "이 세계의 규칙",
	"quest.06B5517AE79C8CB5.quest_desc": [
		"이 세계에서는 물이 모두 같지 않습니다.",
		"바닷물이나 오염된 물을 그대로 마시면 갈증이 해소되지 않습니다.",
		"먼저 안전한 물(증류수)을 만드는 방법을 익혀 봅시다.",
		"읽었다면 체크를 눌러 주세요."
	],
	"quest.31A54275F5864ADA.title": "물 등급을 한눈에 보자",
	"quest.31A54275F5864ADA.quest_desc": [
		"증류수는 안전을 보장합니다. 민물은 급할때 마시기는 충분하지만, 꾸준한 섭취는 좋지 않습니다.",
		"오염된 물과 바닷물은 안전하지 않습니다. 필터와 증류로 정화해야 합니다.",
		"월드의 열린 물은 바닐라 물이 아니라 등급 물입니다."
	],
	"quest.6CBB73CFA3A992F4.title": "체온에 대해",
	"quest.6CBB73CFA3A992F4.quest_desc": [
		"추위·더위는 HUD와 온도계로 확인할 수 있습니다.",
		"갑작스러운 바이옴 이동 전 장비와 물을 챙기는 것을 잊지 마세요."
	],
	"quest.64B0E8886E4D1DA7.title": "벌목에 대해",
	"quest.64B0E8886E4D1DA7.quest_desc": [
		"이 모드팩의 벌목은 Treeliable 모드가 담당합니다.",
		"벌목/쓰러뜨리기를 토글할 수 있습니다."
	],
	"quest.268396713B9B58E9.title": "퀘스트 책에 대해",
	"quest.268396713B9B58E9.quest_desc": [
		"왼쪽 탭에 대한 설명입니다.",
		"튜토리얼: 기초적인 생존과 핵심 진행 루트입니다.",
		"생존 팁: 각종 팁을 모아놓은 부분입니다.",
		"번들: 여유가 된다면 모아서 완료하세요.",
		"도감: 수집과 엔딩. 여유가 생길 때 펼치세요."
	],
	"quest.39C2D77C8287209C.title": "파티와 청크 (OPC)",
	"quest.39C2D77C8287209C.quest_desc": [
		"멀티에서는 Open Parties and Claims로 파티·땅을 관리합니다.",
		"집은 구역으로 설정해도 되지만, 던전·유적 구역은 사유화하지 마세요.",
		"청크 로드는 플레이어당 최대 16청크입니다."
	],
	"quest.4A32BB1FED7C6883.title": "튜토리얼로",
	"quest.4A32BB1FED7C6883.quest_desc": [
		"왼쪽 챕터에서 「I 생존 기반」을 열어 본편을 시작하세요."
	]
}
